# Copy to .env (never commit .env) or export these in your shell.

# Required for lesson generation and the AI-assisted checks (A1-A4).
ANTHROPIC_API_KEY=

# Optional
# LEARN_MODEL=claude-opus-5-5     # model used for generation, repair and checks
# LEARN_EFFORT=high               # effort for writing tasks (plan, lesson, repair): low | medium | high | xhigh | max
# LEARN_CHECK_EFFORT=medium       # effort for selection, OCR and the AI checks
# LEARN_MAX_TOKENS=32000          # output budget per response; thinking counts toward it
# LEARN_MAX_TOKENS_RETRY=64000    # budget for the single retry of a cut-off response (capped at the model's limit)
# LEARN_OCR=auto                  # auto | tesseract | claude | off  (auto: tesseract if installed, else Claude vision)
# LEARN_OUTPUT_DIR=output         # where job folders are written
# CHROMIUM_EXECUTABLE=            # only if Playwright's own Chromium is not installed

# Detective cards chosen by a model (python -m learn.teaching_engine sheet.pdf --case-file case.pdf --ai)
# LEARN_PROVIDER=anthropic        # anthropic (ANTHROPIC_API_KEY) | june (JUNE_API_KEY, June's Anthropic-format API)
#                                 #   | google (GOOGLE_API_KEY, Gemini through Google's OpenAI-style API)
# JUNE_API_KEY=                   # only with LEARN_PROVIDER=june; leave unset when a network secret adds
#                                 #   "Authorization: Bearer <key>" for api.blockchain.info
# GOOGLE_API_KEY=                 # only with LEARN_PROVIDER=google; same network-secret rule, for
#                                 #   generativelanguage.googleapis.com
# LEARN_CARDS_MODEL=              # default claude-haiku-5-5; google/gemini-3.8-flash through June;
#                                 #   gemini-3.5-flash-lite on Google (its free daily quota is far larger)
# LEARN_CARDS_EFFORT=low          # thinking effort for choosing cards; low keeps cost down
# LEARN_CARDS_AI_SHEETS=1         # card sheets per run sent to the model; the rest stay rule-based (free)
# LEARN_EVIDENCE_EFFORT=low       # thinking effort for Detective case papers (low = Gemini thinking off)
# LEARN_DETECTIVE_MAX_PAGES=5     # website: most pages per Detective upload, checked before any model call
# LEARN_DETECTIVE_LINES_PER_REQUEST=40  # website: lines per model request; only longer uploads are split, run at once
# LEARN_DETECTIVE_DAILY_LIMIT=20  # website: uploads a day that may use the model; then the rule-based case file
# LEARN_CARDS_MAX_TOKENS=64000    # output budget per reply, thinking included; a Detective upload is one reply
