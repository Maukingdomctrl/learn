# Copy to .env (never commit .env) or export these in your shell.

# Required for lesson generation and the AI-assisted checks (A1-A4).
ANTHROPIC_API_KEY=

# Optional
# LEARN_MODEL=claude-opus-5-5     # model used for generation, repair and checks
# LEARN_EFFORT=high               # effort for writing tasks (plan, lesson, repair): low | medium | high | xhigh | max
# LEARN_CHECK_EFFORT=medium       # effort for selection, OCR and the AI checks
# LEARN_MAX_TOKENS=32000          # output budget per response; thinking counts toward it
# LEARN_MAX_TOKENS_RETRY=64000    # budget for the single retry of a cut-off response (capped at the model's limit)
# LEARN_OCR=auto                  # auto | tesseract | claude | off  (auto: tesseract if installed, else Claude vision)
# LEARN_OUTPUT_DIR=output         # where job folders are written
# CHROMIUM_EXECUTABLE=            # only if Playwright's own Chromium is not installed
