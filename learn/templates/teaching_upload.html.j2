  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"WebApplication","name":"Learn Teaching Engine","url":"https://learn.mauforge.com/","description":"Turns a curriculum PDF into printable question cards with an answer sheet for classroom revision.","applicationCategory":"EducationalApplication","operatingSystem":"Any","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"}}
  </script>
  <style>
    :root {
      --ink: #0F1E19; --ink-soft: #3E5149; --forest: #2A6049; --forest-deep: #173D2F;
      --mint: #7FE0B5; --gold: #F5B83D; --coral: #FF7A59; --sky: #7CC4F0;
      --paper: #FFFDF7; --line: rgba(15,30,25,.12);
      color-scheme: light;
      font-family: "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
    }
    [hidden] { display: none !important; }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; }
    body {
      color: var(--ink); background: #F4F8F3;
      min-height: 100vh; display: flex; flex-direction: column; overflow-x: hidden; position: relative;
    }
    a { color: var(--forest); text-decoration: none; }
    :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; border-radius: 6px; }

    /* Background */
    .bg { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
    .bg::before {
      content: ""; position: absolute; inset: 0;
      background: radial-gradient(circle at 1px 1px, rgba(23,61,47,.14) 1.2px, transparent 1.6px) 0 0 / 26px 26px;
      -webkit-mask-image: radial-gradient(ellipse at center, #000 40%, transparent 80%);
              mask-image: radial-gradient(ellipse at center, #000 40%, transparent 80%);
    }
    .blob { position: absolute; border-radius: 50%; filter: blur(55px); opacity: .55; }
    .blob.a { width: 420px; height: 420px; background: var(--mint); top: -140px; left: -120px; animation: drift 16s ease-in-out infinite alternate; }
    .blob.b { width: 360px; height: 360px; background: var(--gold); bottom: -150px; right: -100px; animation: drift 20s ease-in-out infinite alternate-reverse; }
    .blob.c { width: 260px; height: 260px; background: var(--sky); top: 30%; right: 8%; opacity: .35; animation: drift 24s ease-in-out infinite alternate; }
    @keyframes drift { to { transform: translate(40px, 30px) scale(1.08); } }

    .shape { position: absolute; }
    .ring { width: 90px; height: 90px; border: 10px solid var(--gold); border-radius: 50%; top: 14%; left: 6%; opacity: .75; animation: float 7s ease-in-out infinite; }
    .tri { width: 0; height: 0; border-left: 26px solid transparent; border-right: 26px solid transparent; border-bottom: 44px solid var(--coral); bottom: 14%; left: 8%; opacity: .8; transform: rotate(-12deg); animation: float 9s ease-in-out infinite reverse; }
    .sq { width: 46px; height: 46px; background: var(--forest); border-radius: 12px; top: 22%; right: 12%; transform: rotate(14deg); opacity: .85; animation: float 8s ease-in-out infinite; }
    .sq2 { width: 30px; height: 30px; background: var(--gold); border-radius: 8px; top: 74%; left: 4%; transform: rotate(-20deg); opacity: .9; animation: float 6s ease-in-out infinite reverse; }
    .sq3 { width: 64px; height: 64px; border: 8px solid var(--forest); border-radius: 16px; top: 8%; right: 34%; transform: rotate(22deg); opacity: .4; animation: float 10s ease-in-out infinite; }
    .sq4 { width: 22px; height: 22px; background: var(--coral); border-radius: 6px; bottom: 22%; right: 6%; transform: rotate(35deg); opacity: .8; animation: float 7s ease-in-out infinite; }
    .sq5 { width: 52px; height: 52px; background: var(--mint); border-radius: 14px; bottom: 8%; left: 38%; transform: rotate(-8deg); opacity: .55; animation: float 9s ease-in-out infinite reverse; }
    .sq6 { width: 18px; height: 18px; border: 4px solid var(--sky); border-radius: 4px; top: 58%; right: 30%; transform: rotate(45deg); opacity: .9; animation: float 6s ease-in-out infinite; }
    .dots { width: 110px; height: 110px; top: 10%; right: 26%; background: radial-gradient(var(--forest) 2.5px, transparent 3px) 0 0 / 16px 16px; opacity: .3; }
    .star { color: var(--gold); font-size: 30px; line-height: 1; animation: twinkle 3.5s ease-in-out infinite; }
    .star.s1 { top: 9%; left: 46%; }
    .star.s2 { bottom: 12%; right: 44%; font-size: 22px; color: var(--coral); animation-delay: 1.2s; }
    .star.s3 { top: 46%; left: 4%; font-size: 18px; color: var(--forest); animation-delay: 2s; }
    @keyframes float { 50% { transform: translateY(-14px); } }
    @keyframes twinkle { 50% { transform: scale(.7) rotate(20deg); opacity: .5; } }

    /* Header and footer share the same width and side padding */
    header, footer { position: relative; z-index: 2; }
    .bar { max-width: 960px; margin: 0 auto; padding: 16px 28px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; }
    .brand-mark {
      width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center;
      background: linear-gradient(135deg, var(--forest), var(--mint)); color: #fff; font-weight: 800;
      box-shadow: 0 6px 16px rgba(42,96,73,.3); transition: transform .4s cubic-bezier(.2,.7,.2,1);
    }
    .brand:hover .brand-mark { transform: rotate(-8deg) scale(1.08); }
    .brand small { font-weight: 600; color: var(--ink-soft); }
    .nav-pill { font-size: 13px; font-weight: 700; color: var(--forest-deep); background: #fff; border: 1px solid var(--line); padding: 7px 14px; border-radius: 999px; box-shadow: 0 4px 12px rgba(15,30,25,.06); }
    footer .bar { font-size: 12px; color: var(--ink-soft); font-weight: 600; }

    /* Main: two columns on wide screens, one on narrow */
    main { position: relative; z-index: 2; flex: 1; display: flex; align-items: center; padding: 8px 0 24px; }
    .wrap { width: 100%; max-width: 960px; margin: 0 auto; padding: 0 28px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: center; }
    .wrap > div:first-child { min-width: 0; }

    .eyebrow {
      display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 800;
      letter-spacing: .1em; text-transform: uppercase; color: var(--forest-deep);
      background: var(--gold); padding: 6px 12px; border-radius: 999px; margin-bottom: 14px;
      box-shadow: 0 6px 14px rgba(245,184,61,.35); transform: rotate(-2deg);
    }
    h1 { font-size: clamp(32px, 4vw, 48px); line-height: 1.06; letter-spacing: -.035em; margin: 0 0 14px; font-weight: 900; }
    .grad {
      background: linear-gradient(90deg, var(--forest), #2fa877, var(--coral), var(--gold), var(--forest));
      background-size: 300% 100%; -webkit-background-clip: text; background-clip: text; color: transparent;
      animation: sheen 6s linear infinite;
    }
    @keyframes sheen { to { background-position: 300% 0; } }
    .lede { font-size: 16px; color: var(--ink-soft); margin: 0 0 24px; max-width: 46ch; line-height: 1.6; }

    /* Glass card */
    .card {
      background: rgba(255,253,247,.82); backdrop-filter: blur(14px) saturate(140%); -webkit-backdrop-filter: blur(14px) saturate(140%);
      border: 1px solid rgba(255,255,255,.9); border-radius: 22px; padding: 26px;
      box-shadow: 0 1px 2px rgba(15,30,25,.05), 0 24px 56px rgba(23,61,47,.16);
      max-width: 100%;
    }
    label { display: block; font-weight: 800; font-size: 13px; margin: 18px 0 6px; }
    label:first-child { margin-top: 0; }
    .opt { color: var(--ink-soft); font-weight: 600; }
    input[type="file"], input[type="text"] {
      display: block; width: 100%; font: inherit; color: var(--ink);
      border: 1.5px solid rgba(15,30,25,.14); border-radius: 12px; background: #fff; padding: 10px 12px;
      transition: border-color .2s, box-shadow .2s;
    }
    input[type="text"]:focus { outline: none; border-color: var(--forest); box-shadow: 0 0 0 4px rgba(245,184,61,.35); }
    .hint { font-size: 12px; color: var(--ink-soft); margin: 6px 0 0; }

    /* Buttons: stacked, full width, same column as the fields */
    .actions { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }
    button {
      display: block; width: 100%; margin: 0; border: 0; border-radius: 14px; padding: 14px 16px;
      font: inherit; font-weight: 800; cursor: pointer; text-align: center;
      transition: transform .15s, box-shadow .2s, background .2s; color: #fff;
      background: linear-gradient(135deg, var(--forest), #2fa877); box-shadow: 0 10px 24px rgba(42,96,73,.3);
    }
    button:hover { transform: translateY(-2px); box-shadow: 0 14px 28px rgba(42,96,73,.38); }
    button:active { transform: translateY(0) scale(.98); }
    button:disabled { opacity: .65; cursor: wait; transform: none; }
    button.secondary { background: #fff; color: var(--ink); border: 1.5px solid var(--line); box-shadow: none; }
    button.secondary:hover { border-color: var(--forest); box-shadow: none; }
    .library-link { display: block; margin-top: 16px; font-size: 13px; font-weight: 700; text-align: center; }
    .library-link:hover { text-decoration: underline; }
    .note { color: var(--ink-soft); font-size: 12px; margin: 14px 0 0; line-height: 1.5; text-align: center; }

    /* Decorative cards */
    .art { position: relative; height: 420px; }
    .qc { position: absolute; width: 230px; border-radius: 18px; padding: 20px; background: #fff; border: 1.5px solid var(--line); box-shadow: 0 20px 40px rgba(23,61,47,.18); }
    .qc .tag { display: inline-block; font-size: 11px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; }
    .qc p { font-weight: 800; font-size: 15px; margin: 10px 0 0; line-height: 1.3; }
    .qc.back { top: 30px; right: 10px; transform: rotate(8deg); background: var(--mint); border-color: transparent; }
    .qc.mid { top: 100px; right: 70px; transform: rotate(-3deg); background: var(--paper); }
    .qc.front { top: 190px; right: 10px; transform: rotate(-9deg); background: var(--forest); border-color: transparent; color: #fff; animation: flip 6s ease-in-out infinite; }
    .qc.front p { color: #fff; }
    .qc.front .tag { background: var(--gold); color: var(--ink); }
    .qc.mid .tag { background: var(--sky); color: #0b2b3d; }
    .qc.back .tag { background: #fff; color: var(--forest-deep); }
    .badge { position: absolute; left: 20px; bottom: 40px; width: 84px; height: 84px; border-radius: 50%; background: var(--coral); color: #fff; display: grid; place-items: center; text-align: center; font-weight: 900; font-size: 13px; line-height: 1.1; transform: rotate(-12deg); box-shadow: 0 12px 24px rgba(255,122,89,.4); animation: float 6s ease-in-out infinite; }
    @keyframes flip { 50% { transform: rotate(-5deg) translateY(-6px); } }

    /* Preview side drawer */
    .scrim { position: fixed; inset: 0; background: rgba(15,30,25,.28); backdrop-filter: blur(2px); opacity: 0; pointer-events: none; transition: opacity .3s; z-index: 10; }
    .scrim.open { opacity: 1; pointer-events: auto; }
    .preview {
      position: fixed; top: 0; right: 0; height: 100%; width: min(560px, 100%); z-index: 11;
      background: var(--paper); box-shadow: -20px 0 50px rgba(15,30,25,.2);
      transform: translateX(105%); transition: transform .4s cubic-bezier(.2,.8,.2,1);
      display: flex; flex-direction: column; padding: 0;
    }
    .preview.open { transform: none; }
    .preview-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--line); }
    .preview-head h2 { margin: 0; font-size: 18px; font-weight: 900; }
    .close { width: 36px; height: 36px; border-radius: 10px; border: 1.5px solid var(--line); background: #fff; color: var(--ink); font-size: 18px; padding: 0; box-shadow: none; flex: 0 0 auto; }
    .close:hover { border-color: var(--forest); transform: none; box-shadow: none; }
    .preview-body { padding: 18px 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; min-height: 0; }
    .preview-body label { margin: 0; }
    .preview-body select { display: block; width: 100%; font: inherit; padding: 10px 12px; border: 1.5px solid rgba(15,30,25,.14); border-radius: 12px; background: #fff; }
    .preview-help { color: var(--ink-soft); font-size: 13px; margin: 0; line-height: 1.5; }
    .preview-frame { display: block; width: 100%; flex: 1; min-height: 360px; border: 1px solid var(--line); border-radius: 12px; background: #f4f5f2; }
    .preview-foot { padding: 14px 22px; border-top: 1px solid var(--line); display: flex; gap: 10px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
    .download-preview { display: none; font-weight: 800; color: var(--forest); font-size: 14px; }
    .preview-foot button { width: auto; margin: 0; padding: 10px 16px; font-size: 14px; }

    /* Loading splash */
    #splash { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; align-content: center; gap: 22px; background: #F4F8F3; transition: opacity .6s ease, visibility .6s; }
    #splash.done { opacity: 0; visibility: hidden; }
    .splash-cards { position: relative; width: 150px; height: 110px; }
    .splash-card { position: absolute; width: 96px; height: 120px; border-radius: 14px; box-shadow: 0 14px 30px rgba(23,61,47,.2); animation: splash-deal 1.6s cubic-bezier(.2,.8,.2,1) infinite; }
    .splash-card.c1 { background: var(--mint); left: 0; top: 10px; animation-delay: 0s; }
    .splash-card.c2 { background: var(--gold); left: 26px; top: 0; animation-delay: .2s; }
    .splash-card.c3 { background: var(--forest); left: 52px; top: 10px; animation-delay: .4s; }
    @keyframes splash-deal {
      0%   { transform: translateY(-30px) rotate(-14deg) scale(.8); opacity: 0; }
      30%  { transform: translateY(0) rotate(0) scale(1); opacity: 1; }
      70%  { transform: translateY(0) rotate(0) scale(1); opacity: 1; }
      100% { transform: translateY(12px) rotate(8deg) scale(.9); opacity: 0; }
    }
    .splash-brand { font-weight: 900; font-size: 18px; color: var(--ink); }
    .splash-bar { width: 180px; height: 6px; border-radius: 999px; background: rgba(15,30,25,.08); overflow: hidden; }
    .splash-bar span { display: block; height: 100%; width: 40%; border-radius: 999px; background: linear-gradient(90deg, var(--forest), var(--mint), var(--gold)); animation: splash-slide 1.2s ease-in-out infinite; }
    @keyframes splash-slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(260%); } }
    .splash-text { font-size: 13px; color: var(--ink-soft); font-weight: 600; }

    @media (max-width: 820px) {
      .wrap { grid-template-columns: 1fr; gap: 24px; }
      .art { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }
    @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
    .eyebrow, h1, .lede, .card, .art { animation: rise .6s cubic-bezier(.2,.7,.2,1) both; }
    h1 { animation-delay: .1s; }
    .lede { animation-delay: .18s; }
    .card { animation-delay: .26s; }
    .art { animation-delay: .3s; }
    /* Fit everything on one screen, no scrolling */
html, body { height: 100%; overflow: hidden; }
body { min-height: 0; height: 100vh; }
header .bar { padding-top: 10px; padding-bottom: 10px; }
footer .bar { padding-top: 8px; padding-bottom: 8px; }
main { flex: 1 1 auto; min-height: 0; align-items: center; padding: 0 0 8px; }
.wrap { gap: 36px; }
.eyebrow { margin-bottom: 8px; }
h1 { font-size: clamp(26px, 3.4vw, 40px); margin-bottom: 8px; }
.lede { font-size: 14px; margin-bottom: 14px; line-height: 1.5; }
.card { padding: 18px 22px; }
label { margin: 12px 0 5px; }
label:first-child { margin-top: 0; }
input[type="file"], input[type="text"] { padding: 8px 12px; }
.hint { margin-top: 4px; }
.actions { margin-top: 14px; gap: 8px; }
button { padding: 11px 14px; }
.library-link { margin-top: 10px; }
.note { margin-top: 8px; }
.art { height: 340px; }
.qc.back { top: 10px; }
.qc.mid { top: 70px; }
.qc.front { top: 150px; }
.badge { bottom: 20px; }
@media (max-height: 760px) {
  .eyebrow { display: none; }
  .lede { display: none; }
  .note { display: none; }
  .hint { display: none; }
}
@media (max-width: 820px) {
  html, body { overflow-y: auto; height: auto; }
  body { height: auto; min-height: 100vh; }
}
/* Shapes react to the cursor */
.shape { transition: translate .6s cubic-bezier(.2,.8,.2,1); }
  </style>
</head>
<body>

<div id="splash" aria-hidden="true">
  <div class="splash-cards">
    <div class="splash-card c1"></div>
    <div class="splash-card c2"></div>
    <div class="splash-card c3"></div>
  </div>
  <div class="splash-brand">Learn</div>
  <div class="splash-bar"><span></span></div>
  <div class="splash-text">Getting your study cards ready…</div>
</div>

<div class="bg" aria-hidden="true">
  <div class="blob a"></div><div class="blob b"></div><div class="blob c"></div>
  <div class="shape ring"></div><div class="shape tri"></div><div class="shape sq"></div>
  <div class="shape sq2"></div><div class="shape sq3"></div><div class="shape sq4"></div>
  <div class="shape sq5"></div><div class="shape sq6"></div><div class="shape dots"></div>
  <span class="shape star s1">✦</span><span class="shape star s2">✦</span><span class="shape star s3">✦</span>
</div>

<header>
  <div class="bar">
    <span class="brand"><span class="brand-mark">L</span>Learn <small>Teaching Engine</small></span>
    <span class="nav-pill">Free · No sign-up</span>
  </div>
</header>

<main>
  <div class="wrap">
    <div>
      <span class="eyebrow">Study smarter</span>
      <h1>Printable question cards from <span class="grad">any curriculum PDF</span></h1>
      <p class="lede">Choose a Detective mystery or a Superhero mission. Your study sheet and its pictures become double-sided game cards with page clues.</p>

      <section class="card">
        <form id="teaching-form" action="/generate" method="post" enctype="multipart/form-data">
          <label for="pdf">Choose a curriculum PDF</label>
          <input id="pdf" type="file" name="pdf" accept="application/pdf" required>
          <p class="hint">Up to 30 MB. Text-based PDFs work best.</p>

          <label for="pages">Pages to use <span class="opt">(optional)</span></label>
          <input id="pages" type="text" name="pages" maxlength="50" placeholder="e.g. 3-5 or 2, 4">

          <input type="hidden" name="standard" value="8">
          <input type="hidden" name="output" value="detective">

          <div class="actions">
            <button id="preview-button" class="secondary" type="button" aria-expanded="false" aria-controls="output-preview">Preview before printing</button>
            <button type="submit">Create question cards</button>
          </div>

          <div class="games" hidden>
            <button type="submit" name="output" value="detective">Play Detective</button>
            <button class="secondary" type="submit" name="output" value="superhero">Play Superhero</button>
          </div>
        </form>
        <a class="library-link" href="/library">Browse the Study Visual Library →</a>
        <p class="note">No account, API key, or paid AI call. Review any flagged claims before teaching.</p>
      </section>
    </div>

    <div class="art" aria-hidden="true">
      <div class="qc back"><span class="tag">Q2</span><p>Name the process plants use to make food.</p></div>
      <div class="qc mid"><span class="tag">Q3</span><p>Which organelle controls the cell?</p></div>
      <div class="qc front"><span class="tag">Q1 · Cells</span><p>What is the powerhouse of the cell?</p></div>
      <div class="badge">Print<br>&amp; cut</div>
    </div>
  </div>
</main>

<footer>
  <div class="bar">
    <span>No account, API key, or paid AI call required.</span>
    <span>Text-based PDFs work best.</span>
  </div>
</footer>

<div class="scrim" id="scrim"></div>
<aside id="output-preview" class="preview" aria-label="Output preview" hidden role="dialog" aria-modal="true" aria-labelledby="preview-title">
  <div class="preview-head">
    <h2 id="preview-title">Print preview</h2>
    <button class="close" id="close-preview" type="button" aria-label="Close preview">✕</button>
  </div>
  <div class="preview-body">
    <label for="preview-output">Choose what to preview</label>
    <select id="preview-output">
      <option value="detective">Detective game cards</option>
      <option value="superhero">Superhero game cards</option>
    </select>
    <p id="preview-status" class="preview-help" aria-live="polite">Choose a game and create its preview. Source images are included where available.</p>
    <iframe id="preview-frame" class="preview-frame" title="Preview of generated learning PDF" src="about:blank"></iframe>
  </div>
  <div class="preview-foot">
    <a id="download-preview" class="download-preview" href="#">Download this preview PDF</a>
    <button class="secondary" id="done-preview" type="button">Close</button>
  </div>
</aside>

<script>
  (function () {
    var splash = document.getElementById("splash");
    var shownAt = Date.now();
    function hideSplash() {
      var wait = Math.max(0, 12000 - (Date.now() - shownAt));
      setTimeout(function () { splash.classList.add("done"); }, wait);
    }
    if (document.readyState === "complete") hideSplash();
    else window.addEventListener("load", hideSplash);
  })();

  const form = document.getElementById("teaching-form");
  const previewButton = document.getElementById("preview-button");
  const previewPanel = document.getElementById("output-preview");
  const scrim = document.getElementById("scrim");
  const closePreview = document.getElementById("close-preview");
  const donePreview = document.getElementById("done-preview");
  const previewFormat = document.getElementById("preview-output");
  const previewFrame = document.getElementById("preview-frame");
  const previewStatus = document.getElementById("preview-status");
  const downloadPreview = document.getElementById("download-preview");
  let previewUrl = null;

  function openPanel() {
    previewPanel.hidden = false;
    requestAnimationFrame(() => {
      previewPanel.classList.add("open");
      scrim.classList.add("open");
    });
    previewButton.setAttribute("aria-expanded", "true");
    closePreview.focus();
  }
  function shutPanel() {
    previewPanel.classList.remove("open");
    scrim.classList.remove("open");
    previewButton.setAttribute("aria-expanded", "false");
    setTimeout(() => { if (!previewPanel.classList.contains("open")) previewPanel.hidden = true; }, 400);
    previewButton.focus();
  }

  closePreview.addEventListener("click", shutPanel);
  donePreview.addEventListener("click", shutPanel);
  scrim.addEventListener("click", shutPanel);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && previewPanel.classList.contains("open")) shutPanel();
  });

  function clearPreview(message) {
    if (previewUrl) URL.revokeObjectURL(previewUrl);
    previewUrl = null;
    previewFrame.src = "about:blank";
    downloadPreview.style.display = "none";
    previewStatus.textContent = message;
  }

  form.addEventListener("input", () => {
    if (previewUrl) clearPreview("Your choices changed. Preview again to see the updated PDF.");
  });
  previewFormat.addEventListener("change", () => {
    if (previewUrl) clearPreview("Your preview format changed. Preview again to see the updated PDF.");
  });

  previewButton.addEventListener("click", async () => {
    openPanel();
    const fileInput = document.getElementById("pdf");
    if (!fileInput.files.length) {
      previewStatus.textContent = "Choose a PDF first.";
      fileInput.focus();
      return;
    }

    previewButton.disabled = true;
    previewStatus.textContent = "Building the same print-ready PDF used for download. This may take a little while for a large document.";
    downloadPreview.style.display = "none";
    const data = new FormData(form);
    data.set("output", previewFormat.value);

    try {
      const response = await fetch("/preview", { method: "POST", body: data });
      const type = response.headers.get("content-type") || "";
      if (!response.ok || !type.includes("application/pdf")) {
        const html = await response.text();
        const message = new DOMParser().parseFromString(html, "text/html").body.textContent.replace(/\s+/g, " ").trim();
        throw new Error(message || "The preview could not be created. Check the PDF and page range.");
      }
      const pdf = await response.blob();
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(pdf);
      previewFrame.src = previewUrl;
      downloadPreview.href = previewUrl;
      downloadPreview.download = previewFormat.value === "lesson" ? "learn_teaching_plan.pdf" : `learn_${previewFormat.value}_game.pdf`;
      downloadPreview.style.display = "inline-block";
      previewStatus.textContent = "Preview ready. This is the PDF produced from your selected input and settings.";
    } catch (error) {
      clearPreview(error.message || "The preview could not be created. Please try again.");
    } finally {
      previewButton.disabled = false;
    }
  });
</script>
<script>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var shapes = Array.prototype.slice.call(document.querySelectorAll(".bg .shape"));
    var radius = 140;   // how close the cursor must be to react (px)
    var strength = 46;  // how far a shape is pushed away (px)

    document.addEventListener("pointermove", function (e) {
      shapes.forEach(function (shape) {
        var rect = shape.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var cy = rect.top + rect.height / 2;
        var dx = cx - e.clientX;
        var dy = cy - e.clientY;
        var dist = Math.sqrt(dx * dx + dy * dy) || 1;
        if (dist < radius) {
          var push = (1 - dist / radius) * strength;
          shape.style.translate = (dx / dist * push).toFixed(1) + "px " + (dy / dist * push).toFixed(1) + "px";
        } else if (shape.style.translate) {
          shape.style.translate = "";
        }
      });
    });

    document.addEventListener("pointerleave", function () {
      shapes.forEach(function (shape) { shape.style.translate = ""; });
    });
  })();
</script>
