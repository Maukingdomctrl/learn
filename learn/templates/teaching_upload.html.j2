{#- A choice of cards is offered when more than one kind is on. -#}
{%- set choose = show_games and (show_superhero or show_facts) -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173D32">

  <title>PDF to Printable Study Cards | Learn</title>
  <meta
    name="description"
    content="{% if show_superhero %}Turn a curriculum PDF into printable study cards for revision. Choose a Detective or Superhero game, preview your cards, and print.{% elif show_facts %}Turn a curriculum PDF into printable revision cards: Detective clue cards to solve, or free Key Facts cards on the sheet's bold words and key points.{% else %}Turn a curriculum PDF into printable Detective clue cards for revision. Preview them, print them and solve the case.{% endif %} No sign-up."
  >
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://learn.mauforge.com/">

  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="Learn Teaching Engine">
  <meta property="og:title" content="Your PDF. Your next study adventure.">
  <meta
    property="og:description"
    content="Create printable study cards from your curriculum PDF. Built for curious minds and revision."
  >
  <meta property="og:url" content="https://learn.mauforge.com/">
  <meta name="twitter:card" content="summary">

  <link
    rel="icon"
    type="image/svg+xml"
    href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='18' fill='%23173D32'/%3E%3Crect x='14' y='18' width='26' height='32' rx='4' fill='%238FB15A' transform='rotate(-14 27 34)'/%3E%3Crect x='24' y='14' width='26' height='32' rx='4' fill='%23DDF58B' transform='rotate(10 37 30)'/%3E%3Cpath d='M31 23h12M31 29h12M31 35h8' stroke='%23173D32' stroke-width='3' stroke-linecap='round' transform='rotate(10 37 30)'/%3E%3C/svg%3E"
  >

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Learn Teaching Engine",
    "url": "https://learn.mauforge.com/",
    "description": "Create printable question cards from curriculum PDFs for classroom revision and independent study.",
    "applicationCategory": "EducationalApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires JavaScript for PDF previews.",
    "isAccessibleForFree": true,
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
  </script>

  <style>
    /* ---------- Design tokens ---------- */
    :root {
      color-scheme: light;
      --paper: #f7f8f2;
      --white: #fff;
      --ink: #18352c;
      --muted: #52655b;
      --forest: #173d32;
      --forest-light: #285a47;
      --lime: #ddf58b;
      --lilac: #e5def9;
      --peach: #ffe0cc;
      --line: #dce3d8;
      --radius: 28px;
      --shadow: 0 24px 70px -36px rgb(24 53 44 / 35%);
      --ease: cubic-bezier(.22, 1, .36, 1);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; }
    [hidden] { display: none !important; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 24px;
    }

    body {
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    body.modal-open { overflow: hidden; }
    button, input, select { font: inherit; }
    button, a, input, select { -webkit-tap-highlight-color: transparent; }
    button, select { cursor: pointer; }
    a { color: inherit; text-underline-offset: 4px; }
    button { color: inherit; }
    svg { display: block; }
    ::selection { color: var(--forest); background: var(--lime); }

    :focus-visible {
      outline: 3px solid #7052b5;
      outline-offset: 5px;
    }

    .container {
      width: min(1180px, calc(100% - 64px));
      margin-inline: auto;
    }

    .skip-link {
      position: fixed;
      inset: 12px auto auto 12px;
      z-index: 100;
      padding: 12px 20px;
      border-radius: 12px;
      background: var(--forest);
      color: white;
      transform: translateY(-160%);
    }

    .skip-link:focus { transform: none; }

    /* ---------- Quiet atmosphere ---------- */
    .ambient {
      position: absolute;
      inset: 0 0 auto;
      height: 1000px;
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
      background:
        radial-gradient(ellipse at 90% 12%, #e5ebd6 0, transparent 45%),
        radial-gradient(ellipse at 0% 35%, #eef0df 0, transparent 45%);
    }

    .ambient::after {
      content: "";
      position: absolute;
      inset: 0;
      opacity: .35;
      background-image: radial-gradient(#9eafa0 .8px, transparent .8px);
      background-size: 24px 24px;
      mask-image: linear-gradient(#000, transparent 85%);
    }

    /* ---------- Navigation ---------- */
    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding-block: 26px;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .brand-mark {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      color: var(--lime);
      background: var(--forest);
      font-size: 28px;
      font-weight: 900;
      box-shadow: 0 6px 0 #dce6d7;
      transition: transform .3s var(--ease);
    }

    .brand:hover .brand-mark { transform: rotate(-8deg); }
    .brand-name { font-size: 23px; font-weight: 850; letter-spacing: -.8px; }
    .brand-caption { display: block; font-size: 12px; color: var(--muted); }

    nav { display: flex; align-items: center; gap: 24px; }
    nav a { font-size: 14px; font-weight: 700; text-decoration: none; }
    nav a:hover { text-decoration: underline; }

    /* Small text links get a taller tap area; the negative margin keeps the layout as it was. */
    nav a, .text-link, .site-footer a { padding-block: 10px; margin-block: -10px; }

    .free-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border: 1px solid #d3dec9;
      border-radius: 100px;
      background: #eef3e7;
      font-size: 13px;
      font-weight: 750;
      white-space: nowrap;
    }

    .free-pill::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #35673a;
    }

    /* ---------- Hero ---------- */
    .hero {
      display: grid;
      grid-template-columns: 1.08fr .92fr;
      align-items: center;
      gap: 72px;
      padding-block: 76px 68px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin: 0 0 22px;
      color: var(--forest-light);
      font-size: 12px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .eyebrow span {
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--lime);
      letter-spacing: .03em;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1 {
      max-width: 12ch;
      margin-bottom: 24px;
      font-size: clamp(44px, 5.5vw, 72px);
      font-weight: 850;
      line-height: 1.04;
      letter-spacing: -.065em;
      text-wrap: balance;
    }

    .highlight {
      position: relative;
      isolation: isolate;
      white-space: nowrap;
    }

    .highlight::before {
      content: "";
      position: absolute;
      inset: 55% -5px 2px;
      z-index: -1;
      border-radius: 5px;
      background: var(--lime);
      transform: rotate(-2deg);
    }

    .intro {
      max-width: 43ch;
      margin-bottom: 24px;
      font-size: 17px;
      color: var(--muted);
      line-height: 1.8;
    }

    .benefits {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      padding: 0;
      margin: 0;
      list-style: none;
      color: var(--forest);
      font-size: 13px;
      font-weight: 700;
    }

    /* The empty alt text keeps screen readers from announcing the tick; older browsers use the first value. */
    .benefits li::before { content: "✓"; content: "✓" / ""; margin-right: 7px; }

    /* ---------- Animated study-card composition ---------- */
    .study-scene {
      position: relative;
      height: 260px;
      max-width: 470px;
      margin-top: 35px;
      perspective: 1000px;
    }

    .scene-orbit {
      position: absolute;
      width: 235px;
      height: 235px;
      top: 8px;
      left: 80px;
      border: 1px dashed #bdcbb8;
      border-radius: 50%;
    }

    .scene-orbit::after {
      content: "";
      position: absolute;
      top: 30px;
      right: 22px;
      width: 13px;
      height: 13px;
      border: 4px solid var(--paper);
      border-radius: 50%;
      background: var(--forest);
      box-shadow: 0 0 0 1px #bdcbb8;
    }

    .scene-stack {
      position: relative;
      height: 100%;
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      transition: transform .6s var(--ease);
    }

    .sample {
      position: absolute;
      width: 218px;
      min-height: 154px;
      padding: 20px;
      border: 1px solid rgb(24 53 44 / 12%);
      border-radius: 19px;
      box-shadow: 0 16px 32px -20px rgb(24 53 44 / 50%);
    }

    .sample-back {
      left: 235px;
      top: 19px;
      background: var(--lilac);
      rotate: 11deg;
      animation: bob 4.5s ease-in-out .4s;
    }

    .sample-front {
      left: 35px;
      top: 77px;
      color: white;
      background: var(--forest);
      rotate: -8deg;
      animation: bob 4.5s ease-in-out;
    }

    .sample-top {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 16px;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .sample-front .sample-top { color: var(--lime); }
    .sample p { margin: 0; font-size: 15px; font-weight: 700; line-height: 1.5; }

    .sample-foot {
      display: block;
      margin-top: 17px;
      padding-top: 9px;
      border-top: 1px solid rgb(255 255 255 / 20%);
      font-size: 10px;
      color: #e0e9df;
    }

    .scene-sticker {
      position: absolute;
      right: 4px;
      bottom: 12px;
      display: grid;
      place-items: center;
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: var(--peach);
      border: 5px solid var(--paper);
      font-size: 11px;
      font-weight: 850;
      text-align: center;
      line-height: 1.3;
      rotate: 12deg;
    }

    /* ---------- Builder ---------- */
    /* The panel is its own stacking context with the white surface on ::after, so the tilted backing card
       stays behind it. Painted on .builder itself, the surface sat under the backing card in Chrome: the
       entrance animation fills forwards, which keeps .builder a stacking context after it ends. */
    .builder {
      position: relative;
      isolation: isolate;
      padding: 30px;
      border-radius: 32px;
    }

    .builder::before, .builder::after {
      content: "";
      position: absolute;
      border-radius: 32px;
    }

    .builder::before {
      inset: 12px -9px -12px 12px;
      z-index: -2;
      border: 1px solid #dce3d3;
      background: #e9efdf;
      rotate: 2deg;
    }

    .builder::after {
      inset: 0;
      z-index: -1;
      border: 1px solid white;
      background: rgb(255 255 255 / 94%);
      box-shadow: var(--shadow), 0 0 0 1px rgb(24 53 44 / 5%);
    }

    .builder-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 24px;
    }

    .builder-heading h2 {
      margin: 0;
      font-size: 23px;
      letter-spacing: -.8px;
      line-height: 1.25;
    }

    .builder-heading p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 14px;
    }

    .builder-heading .hint { font-size: 13px; }

    .mini-icon {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      border-radius: 14px;
      background: var(--lime);
    }

    .field-label, legend {
      display: block;
      margin-bottom: 9px;
      font-size: 14px;
      font-weight: 800;
    }

    .optional { color: var(--muted); font-weight: 500; }
    .field { margin-top: 21px; }

    .upload {
      position: relative;
      display: grid;
      justify-items: center;
      gap: 5px;
      padding: 24px 16px;
      border: 1.5px dashed #b7c6ac;
      border-radius: 18px;
      background: #f7f9f2;
      text-align: center;
      transition: background .2s, border-color .2s, transform .3s var(--ease);
    }

    .upload.has-file { border-style: solid; border-color: var(--forest-light); background: #f0f6e6; }

    .upload:hover, .upload.dragging {
      background: #eff5e3;
      border-color: var(--forest);
      transform: translateY(-2px);
    }

    .upload:focus-within { outline: 3px solid #7052b5; outline-offset: 4px; }

    .upload input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .upload-icon {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin-bottom: 5px;
      border-radius: 13px;
      background: white;
      border: 1px solid var(--line);
    }

    .upload strong {
      max-width: 100%;
      overflow-wrap: anywhere;
      font-size: 15px;
    }

    .upload small { color: var(--muted); font-size: 13px; }
    .try-sample { margin: 10px 0 0; color: var(--muted); font-size: 13px; text-align: center; }
    .try-sample a { padding-block: 6px; color: var(--forest-light); font-weight: 750; white-space: nowrap; }

    input[type="text"] {
      width: 100%;
      min-height: 47px;
      padding: 11px 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fbfcf9;
      color: var(--ink);
      font-size: 16px;  /* below 16px, iPhones zoom the page in when the field gets focus */
      transition: border-color .2s, box-shadow .2s;
    }

    input[type="text"]:focus {
      border-color: var(--forest);
      box-shadow: 0 0 0 4px #edf3e5;
    }

    input[type="text"]::placeholder { color: var(--muted); opacity: 1; }

    .hint {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    fieldset { min-width: 0; padding: 0; border: 0; margin: 21px 0 0; }
    legend { padding: 0; }
    .game-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .product-note {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 21px;
      padding: 13px 14px;
      border-radius: 13px;
      background: #f0f6e6;
    }

    .product-note strong { display: block; font-size: 14px; }
    .product-note small { display: block; color: var(--muted); font-size: 13px; }
    .product-note a, .form-note a { padding-block: 6px; white-space: nowrap; }  /* inline padding moves no lines */

    .game-option { position: relative; cursor: pointer; }

    .game-option input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    .game-tile {
      display: flex;
      align-items: center;
      gap: 9px;
      height: 100%;
      padding: 13px 10px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: white;
      transition: background .2s, border-color .2s, transform .2s;
    }

    .game-tile strong { display: block; font-size: 14px; }
    .game-tile small { display: block; color: var(--muted); font-size: 12px; }
    .game-symbol { font-size: 20px; }

    .game-option input:checked + .game-tile {
      background: #f0f6e6;
      border-color: var(--forest);
      box-shadow: inset 0 0 0 1px var(--forest);
    }

    .game-option input:focus-visible + .game-tile {
      outline: 3px solid #7052b5;
      outline-offset: 3px;
    }

    .game-option:hover .game-tile { transform: translateY(-2px); }
    .actions { display: grid; gap: 9px; margin-top: 24px; }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 48px;
      padding: 12px 18px;
      border: 1px solid transparent;
      border-radius: 13px;
      background: var(--forest);
      color: white;
      font-size: 15px;
      font-weight: 750;
      text-decoration: none;
      transition: transform .25s var(--ease), background .2s, box-shadow .25s;
    }

    .button:hover {
      background: var(--forest-light);
      transform: translateY(-2px);
      box-shadow: 0 9px 20px -12px var(--forest);
    }

    .button:active { transform: translateY(0); }
    .button:disabled { opacity: .6; cursor: wait; transform: none; }
    .button svg { width: 17px; height: 17px; }

    .button-secondary {
      background: white;
      border-color: var(--line);
      color: var(--ink);
    }

    .button-secondary:hover { background: #f6f8f1; }

    .form-note {
      margin: 14px 0 0;
      color: var(--muted);
      text-align: center;
      font-size: 12px;
    }

    .form-error { margin: 12px 0 0; color: #a32c26; font-size: 13px; }

    /* ---------- Real sample ---------- */
    .proof-section {
      display: grid;
      grid-template-columns: 1fr minmax(0, 420px);
      align-items: center;
      gap: 56px;
      padding-block: 48px 64px;
      border-top: 1px solid var(--line);
    }

    .proof-copy h2 { margin-bottom: 14px; }
    .proof-copy > p:not(.section-kicker) { color: var(--muted); font-size: 15px; }
    .proof-points { margin: 18px 0; padding-left: 20px; font-size: 15px; }
    .proof-points li { margin: 6px 0; }
    .proof-links { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 15px; font-weight: 750; }
    .proof-links a { color: var(--forest-light); }

    .proof-page img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: white;
      box-shadow: var(--shadow);
    }

    /* ---------- Helpful, crawlable content ---------- */
    .how-section {
      padding-block: 48px 64px;
      border-top: 1px solid var(--line);
    }

    .section-top {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 26px;
    }

    .section-kicker {
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    h2 { margin-bottom: 0; font-size: clamp(25px, 3vw, 34px); letter-spacing: -1.2px; line-height: 1.2; }
    .text-link { font-size: 14px; font-weight: 750; }

    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

    .step {
      padding: 25px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: rgb(255 255 255 / 55%);
    }

    .step-number {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      margin-bottom: 20px;
      border-radius: 10px;
      background: var(--lime);
      font-size: 11px;
      font-weight: 850;
    }

    .step:nth-child(2) .step-number { background: var(--lilac); }
    .step:nth-child(3) .step-number { background: var(--peach); }
    .step h3 { margin-bottom: 8px; font-size: 17px; letter-spacing: -.3px; }
    .step p { margin: 0; color: var(--muted); font-size: 15px; }

    .faq {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 70px;
      padding-block: 12px 70px;
    }

    .faq-intro p:last-child { margin-top: 16px; color: var(--muted); font-size: 15px; }

    details { border-bottom: 1px solid var(--line); }
    summary {
      padding: 18px 32px 18px 0;
      position: relative;
      list-style: none;
      font-size: 16px;
      font-weight: 750;
      cursor: pointer;
    }

    summary::-webkit-details-marker { display: none; }
    summary::after { content: "+"; content: "+" / ""; position: absolute; right: 4px; font-size: 20px; top: 15px; }
    details[open] summary::after { content: "−"; content: "−" / ""; }
    details p { padding-right: 26px; color: var(--muted); font-size: 15px; }

    .site-footer {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding-block: 23px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 13px;
    }

    /* ---------- Native modal preview ---------- */
    .preview {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(100%, max(700px, 75vw));  /* three quarters of a wide screen: room to look through the cards */
      max-width: 100%;
      height: 100%;
      height: 100dvh;
      max-height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      color: var(--ink);
      background: var(--paper);
      box-shadow: -25px 0 90px rgb(0 0 0 / 15%);
    }

    .preview[open] {
      display: flex;
      flex-direction: column;
      animation: drawer-in .35s var(--ease);
    }

    .preview::backdrop { background: rgb(14 31 25 / 50%); }

    .preview-head, .preview-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 20px 24px;
      flex-shrink: 0;
    }

    .preview-head { border-bottom: 1px solid var(--line); }
    .preview-head h2 { font-size: 23px; }
    .preview-foot { border-top: 1px solid var(--line); flex-wrap: wrap; }

    .icon-button {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: white;
      font-size: 24px;
    }

    .preview-body {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      padding: 20px 24px;
      gap: 16px;
      overflow: auto;
    }

    .preview-status { margin: 0; color: var(--muted); font-size: 14px; }

    .preview-frame {
      width: 100%;
      flex: 1;
      min-height: 240px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: white;
    }

    .preview-pages { display: grid; gap: 16px; }
    .preview-pages img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 12px; }

    .preview-loading {
      height: 3px;
      overflow: hidden;
      border-radius: 3px;
      background: #dce5d3;
      flex-shrink: 0;
    }

    .preview-loading::after {
      content: "";
      display: block;
      width: 35%;
      height: 100%;
      background: var(--forest);
      animation: loading 1.2s ease-in-out infinite;
    }

    /* ---------- Key Facts: take out cards before printing ---------- */
    .picker { display: grid; gap: 14px; }
    .pick-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 16px; }
    .pick-count { margin: 0; font-size: 15px; font-weight: 750; }
    .pick-notes {
      display: grid;
      gap: 6px;
      margin: 0;
      padding: 12px 14px 12px 30px;
      border: 1px solid #ead7a8;
      border-radius: 13px;
      background: #fff8e6;
      font-size: 13px;
    }
    .pick-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .pick-card {
      position: relative;
      padding: 14px 62px 15px 16px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: white;
    }

    .pick-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 10px;
      margin: 0 0 6px;
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
    }

    .pick-number { color: var(--forest); }
    .pick-clue { margin: 0; font-size: 15px; font-weight: 650; line-height: 1.45; overflow-wrap: anywhere; white-space: pre-line; }
    .pick-question { margin: 7px 0 0; color: var(--forest-light); font-size: 13px; font-weight: 750; }
    .pick-answer { margin: 3px 0 0; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
    .pick-answer strong { color: var(--ink); }

    .pick-remove {
      position: absolute;
      top: 8px;
      right: 8px;
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: white;
      color: var(--muted);
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      transition: background .2s, border-color .2s, color .2s;
    }

    .pick-remove:hover { border-color: #e7b7a8; background: #fbeeea; color: #8b331c; }

    .link-button {
      padding: 10px 0;
      border: 0;
      background: none;
      color: var(--forest-light);
      font: inherit;
      font-size: 14px;
      font-weight: 750;
      text-decoration: underline;
      text-underline-offset: 4px;
      cursor: pointer;
    }

    /* ---------- Motion ---------- */
    /* The sample cards float once and stop: decorative motion beside the form ends within five seconds. */
    @keyframes bob { 50% { translate: 0 -9px; } }
    @keyframes drawer-in { from { transform: translateX(100%); } to { transform: none; } }
    @keyframes loading { from { transform: translateX(-110%); } to { transform: translateX(390%); } }
    @keyframes arrive {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: none; }
    }

    .hero-copy { animation: arrive .8s var(--ease) both; }
    .builder { animation: arrive .8s .12s var(--ease) both; }

    /* ---------- Responsive ---------- */
    @media (min-width: 900px) {
      .how-section, .faq { content-visibility: auto; contain-intrinsic-size: auto 380px; }
    }

    @media (max-width: 1000px) {
      .hero { gap: 36px; }
      .builder { padding: 24px; }
      .sample-back { left: 215px; top: 0; }
      .scene-sticker { right: 0; }
    }

    /* One column from 900px down: two columns left the form about 300px wide on small tablets. */
    @media (max-width: 900px) {
      .container { width: min(600px, calc(100% - 40px)); }
      .hero { grid-template-columns: 1fr; gap: 32px; padding-block: 44px; }
      h1 { max-width: 15ch; font-size: clamp(43px, 8vw, 62px); }
      .intro { max-width: 48ch; }
      .study-scene { display: none; }
      nav a { display: none; }
      .steps { grid-template-columns: 1fr; }
      .step { padding: 22px; }
      .step-number { margin-bottom: 14px; }
      .faq { grid-template-columns: 1fr; gap: 15px; }
      .section-top { align-items: start; flex-direction: column; gap: 14px; }
      .builder::before { inset: 10px -5px -8px 8px; rotate: 1deg; }
      .site-footer > span { flex-basis: 100%; }
      .proof-section { grid-template-columns: 1fr; gap: 28px; }
      .proof-page { max-width: 420px; }
    }

    @media (max-width: 380px) {
      .container { width: calc(100% - 28px); }
      .builder { padding: 20px; }
      .free-pill { padding: 7px 9px; font-size: 12px; }
      .game-grid { grid-template-columns: 1fr; }
      .brand-caption { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
      }
      .scene-stack { transform: none !important; }
    }
  </style>
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="ambient" aria-hidden="true"></div>

  <header class="site-header container">
    <a class="brand" href="/" aria-label="Learn Teaching Engine home">
      <span class="brand-mark" aria-hidden="true">L</span>
      <span>
        <span class="brand-name">Learn</span>
        <span class="brand-caption">A little curiosity goes a long way.</span>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <a href="#how-it-works">How it works</a>
      <a href="/library">Study library</a>
      <span class="free-pill">Free · No sign-up</span>
    </nav>
  </header>

  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Big ideas. Small cards.</p>

        <h1 id="hero-title">
          Turn your PDF into a <span class="highlight">study quest.</span>
        </h1>

        <p class="intro">
          Less staring at notes. More figuring things out.
          Turn your curriculum PDF into printable question cards,
          then solve a mystery{% if show_superhero %} or take on a superhero mission{% elif show_facts %} or
          quiz yourself on the key facts{% endif %}.
        </p>

        <ul class="benefits" aria-label="Features">
          <li>Print-ready cards</li>
          <li>Answer sheet included</li>
          <li>No account needed</li>
        </ul>

        <div class="study-scene" aria-hidden="true">
          <div class="scene-orbit"></div>
          <div class="scene-stack">
            <div class="sample sample-back">
              <div class="sample-top">
                <span>Biology</span><span>Sample · 02</span>
              </div>
              <p>How do plants turn sunlight into food?</p>
            </div>

            <div class="sample sample-front">
              <div class="sample-top">
                <span>Detective mode</span><span>Sample · 01</span>
              </div>
              <p>Your cell needs energy. Which organelle is on the case?</p>
              <span class="sample-foot">Think it through. Then check your answer.</span>
            </div>
          </div>
          <div class="scene-sticker">A fresh way<br>to revise</div>
        </div>
      </div>

      <section class="builder" aria-labelledby="builder-title">
        <div class="builder-heading">
          <div>
            <h2 id="builder-title">{% if show_games and not choose %}Make your Detective cards{% else %}Build your study cards{% endif %}</h2>
            <p>Your notes. A new way to know them.</p>
            <p class="hint" id="audience-note">
              For parents and students aged 18+. Younger students: ask a parent to upload your notes.
            </p>
          </div>
          <span class="mini-icon" aria-hidden="true">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.6">
              <rect x="7" y="4" width="13" height="16" rx="3"/>
              <path d="M4 7H3v12a3 3 0 0 0 3 3h9M11 9h5m-5 4h5"/>
            </svg>
          </span>
        </div>

        <form id="teaching-form" action="/generate" method="post"
          enctype="multipart/form-data">
          <label class="field-label" for="pdf">1. Add your curriculum PDF</label>

          <div class="upload" id="upload-zone">
            <span class="upload-icon" aria-hidden="true">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 16V4m-4 4 4-4 4 4M4 16v4h16v-4"/>
              </svg>
            </span>
            <strong id="file-name">Choose a PDF or drop it here</strong>
            <small id="file-help">Up to 30 MB · Text-based PDFs work best</small>
            <input id="pdf" type="file" name="pdf"
              accept=".pdf,application/pdf" required
              aria-describedby="file-help file-name">
          </div>

          {% if show_games and ai_cards %}
          <p class="try-sample">
            No PDF to hand? <a href="/sample-case-papers.pdf" id="try-sample">Try it with our example sheet</a>
          </p>
          {% endif %}

          <div class="field">
            <label class="field-label" for="pages">
              2. Pick your pages <span class="optional">(optional)</span>
            </label>
            <input id="pages" name="pages" type="text"
              maxlength="50" placeholder="For example: 3-5 or 2, 4"
              aria-describedby="pages-help" autocomplete="off"
              spellcheck="false">
            <p class="hint" id="pages-help">
              Use the PDF's page numbers. Leave blank to use all pages.{% if show_games %}
              Detective works on up to {{ detective_max_pages }} pages at a time.{% if show_facts %} Key Facts
              takes any number.{% endif %}{% endif %}
            </p>
          </div>

          <input type="hidden" name="standard" value="8">
          <input type="hidden" name="skip" id="skip-cards" value="">

          {% if choose %}
          <fieldset>
            <legend>{% if show_superhero %}3. Choose your adventure{% else %}3. Choose your cards{% endif %}</legend>
            <div class="game-grid">
              {# Key Facts comes first and is chosen to start with: it needs no AI, so nothing is spent on a model
                 unless a parent picks Detective. #}
              {% if show_facts %}
              <label class="game-option">
                <input type="radio" name="output" value="facts" checked>
                <span class="game-tile">
                  <span class="game-symbol" aria-hidden="true">★</span>
                  <span>
                    <strong>Key Facts</strong>
                    <small>Bold words and key points</small>
                  </span>
                </span>
              </label>
              {% endif %}

              <label class="game-option">
                <input type="radio" name="output" value="detective"{% if not show_facts %} checked{% endif %}>
                <span class="game-tile">
                  <span class="game-symbol" aria-hidden="true">⌕</span>
                  <span>
                    <strong>Detective</strong>
                    <small>{% if show_facts %}Story clues to solve{% else %}Follow the clues{% endif %}</small>
                  </span>
                </span>
              </label>

              {% if show_superhero %}
              <label class="game-option">
                <input type="radio" name="output" value="superhero">
                <span class="game-tile">
                  <span class="game-symbol" aria-hidden="true">ϟ</span>
                  <span>
                    <strong>Superhero</strong>
                    <small>Take on a mission</small>
                  </span>
                </span>
              </label>
              {% endif %}
            </div>
          </fieldset>
          {% elif show_games %}
          <input type="hidden" name="output" value="detective">
          <div class="product-note">
            <span class="game-symbol" aria-hidden="true">⌕</span>
            <span>
              <strong>Detective</strong>
              <small>Clue cards to solve, with the answers on a separate page.{% if ai_cards %}
                <a href="#sample">See a sample</a>{% endif %}</small>
            </span>
          </div>
          {% else %}
          <input type="hidden" name="output" value="study">
          {% endif %}

          <p class="form-error" id="form-error" role="alert" hidden></p>

          <div class="actions">
            <button class="button" type="submit">
              {% if show_games and not choose %}Create my Detective cards{% else %}Create my study cards{% endif %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.8" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6"/>
              </svg>
            </button>

            <button class="button button-secondary" id="preview-button"
              type="button" aria-haspopup="dialog"
              aria-controls="output-preview" hidden>
              Preview before printing
            </button>
          </div>

          <p class="form-note">
            No account or API key needed. Check your answers before class.
            <a href="/privacy">How we handle your PDF</a>
          </p>
        </form>

        <noscript>
          <p class="hint">
            You can still create cards. Enable JavaScript for an in-page preview.
          </p>
        </noscript>
      </section>
    </section>

    {% if show_games and ai_cards %}
    <section class="proof-section container" id="sample" aria-labelledby="proof-title">
      <div class="proof-copy">
        <p class="section-kicker">A real sample</p>
        <h2 id="proof-title">What you'll print</h2>
        <p>
          Learn's AI wrote this case paper from a short example sheet written for this page, not taken from any
          textbook. Your cards come from the pages you upload.
        </p>
        <ul class="proof-points">
          <li><strong>Clue cards, eight to a page.</strong> Each is a short everyday scene with one question.</li>
          <li><strong>An answer key for the adult.</strong> Each answer shows the line of the sheet it comes from.</li>
          <li><strong>A score box</strong> to close the case.</li>
        </ul>
        <p class="proof-links">
          <a href="/sample-case-papers.pdf">Open the sample (PDF)</a>
          <a href="/sample-sheet.pdf">See the example sheet</a>
        </p>
        <p class="hint">When the day's AI cards are used up, you get basic Detective cards instead, with a note saying why.</p>
      </div>
      <a class="proof-page" href="/sample-case-papers.pdf">
        <img src="/sample-case-papers-1.png" width="910" height="1287" loading="lazy"
          alt="Page 1 of the sample case paper, The Case of the Green Kitchen: eight clue cards, each a short scene with a question">
      </a>
    </section>
    {% endif %}

    <section class="how-section container" id="how-it-works"
      aria-labelledby="how-title">
      <div class="section-top">
        <div>
          <p class="section-kicker">From notes to know-how</p>
          <h2 id="how-title">Three steps. A different kind of revision.</h2>
        </div>
        <a class="text-link" href="/library">Explore the study library ↗</a>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step-number" aria-hidden="true">01</span>
          <h3>Start with what you're learning</h3>
          <p>
            Upload a curriculum PDF or study sheet. Choose one topic
            or a few pages to keep your session focused.
          </p>
        </article>

        <article class="step">
          <span class="step-number" aria-hidden="true">02</span>
          <h3>Make it a mission</h3>
          <p>
            {% if show_superhero %}Pick Detective or Superhero. Preview your question cards
            and check that the content matches your lesson.{% elif show_facts %}Key Facts asks quick questions on what
            your sheet marks to learn, and you can take out any card you don't want. Or pick Detective for a case to
            solve. Preview your cards before you print.{% elif show_games %}Your cards come as a Detective case to
            solve. Preview them and check that the content matches your lesson.{% else %}Preview your question cards
            and check that the content matches your lesson.{% endif %}
          </p>
        </article>

        <article class="step">
          <span class="step-number" aria-hidden="true">03</span>
          <h3>Print. Think. Try again.</h3>
          <p>
            Cut out your cards. Answer on your own or quiz a friend,
            then use the answer sheet to see what needs another look.
          </p>
        </article>
      </div>
    </section>

    <section class="faq container" aria-labelledby="faq-title">
      <div class="faq-intro">
        <p class="section-kicker">Good questions welcome</p>
        <h2 id="faq-title">Before you start</h2>
        <p>
          A few useful things to know about making printable
          study cards from your PDF.
        </p>
      </div>

      <div>
        <details>
          <summary>What kind of PDF should I upload?</summary>
          <p>
            Use a text-based curriculum PDF, lesson handout, or study sheet
            up to 30 MB. PDFs with selectable text work best.
            Scanned pages or photos may not produce useful cards.
          </p>
        </details>

        {% if show_games and show_facts %}
        <details>
          <summary>Key Facts or Detective?</summary>
          <p>
            Key Facts asks about the words your sheet prints in bold, its bullet points and its numbered points, with
            the answer word for word from the sheet. It uses no AI, has no daily limit, and lets you take out any card
            before you print. Detective turns your sheet into clue cards, each a short scene to solve.{% if ai_cards %}
            An AI writes them, so there are a limited number each day.{% endif %}
          </p>
        </details>
        {% endif %}

        <details>
          <summary>What happens to my PDF?</summary>
          <p>
            It's read on our server to make your cards, and it isn't saved.{% if ai_cards %} To write Detective cards,
            the text of the pages you choose is sent to an AI model.{% if show_facts %} Key Facts cards are made on
            our server without AI.{% endif %}{% endif %}
            <a href="/privacy">How we handle your PDF</a>
          </p>
        </details>

        <details>
          <summary>Which class is this for?</summary>
          <p>
            Any class with chapter notes. Upload material from your
            own lessons so the cards match what you are studying.
            The quality and difficulty of the cards also depend on your PDF.
          </p>
        </details>

        <details>
          <summary>Do I need an account or an API key?</summary>
          <p>
            No. You can upload a PDF, preview the output, and create your
            printable cards without signing up or supplying an API key.
          </p>
        </details>

        <details>
          <summary>Should I check the cards before using them?</summary>
          <p>
            Yes. Compare questions and answers with your source material.
            Ask your teacher about anything unclear, and review any flagged
            claims before using the cards in class.
          </p>
        </details>

        <details>
          <summary>How do I print the cards?</summary>
          <p>
            Preview or download the generated PDF, then open it in your
            PDF viewer to print. Check its page layout and any printing
            instructions before choosing double-sided settings.
          </p>
        </details>
      </div>
    </section>
  </main>

  <footer class="site-footer container">
    <span>
      Learn is made by {{ contact.name }} in {{ contact.city }}.
      <a href="mailto:{{ contact.email }}">{{ contact.email }}</a>
    </span>
    <a href="/blank-cards" download>Blank study cards (PDF) ↓</a>
    <a href="/library">Study Visual Library ↗</a>
    <a href="/privacy">Privacy and your PDF</a>
  </footer>

  <dialog class="preview" id="output-preview"
    aria-labelledby="preview-title" aria-describedby="preview-status">
    <div class="preview-head">
      <div>
        <p class="section-kicker">One last look</p>
        <h2 id="preview-title">Your print preview</h2>
      </div>
      <button class="icon-button" id="close-preview"
        type="button" aria-label="Close preview" autofocus>×</button>
    </div>

    <div class="preview-body">
      <p class="preview-status" id="preview-status"
        role="status" aria-live="polite"></p>
      <div class="preview-loading" id="preview-loading"
        aria-hidden="true" hidden></div>
      <iframe class="preview-frame" id="preview-frame"
        title="Generated study cards PDF preview" src="about:blank"></iframe>
      <div class="picker" id="card-picker" hidden>
        <div class="pick-tools">
          <p class="pick-count" id="pick-count" tabindex="-1" aria-live="polite"></p>
          <button class="link-button" id="pick-restore" type="button" hidden>Put them all back</button>
        </div>
        <ul class="pick-notes" id="pick-notes" hidden></ul>
        <ol class="pick-list" id="pick-list" aria-label="Your Key Facts cards"></ol>
      </div>
      {% if sample_pages %}
      <div class="preview-pages" id="sample-pages" hidden>
        {% for page in range(1, sample_pages + 1) %}
        <img src="/sample-case-papers-{{ page }}.png" width="910" height="1287" loading="lazy"
          alt="Sample case paper, page {{ page }} of {{ sample_pages }}">
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="preview-foot">
      <a class="button" id="download-preview" hidden>Download PDF ↗</a>
      <button class="button" id="final-preview" type="button" hidden>See the final PDF</button>
      <button class="button button-secondary" id="edit-cards" type="button" hidden>Back to the cards</button>
      <button class="button button-secondary" id="done-preview" type="button">
        Back to my cards
      </button>
    </div>
  </dialog>

  <script>
    (() => {
      "use strict";

      const $ = (id) => document.getElementById(id);
      const form = $("teaching-form");
      const fileInput = $("pdf");
      const pagesInput = $("pages");
      const upload = $("upload-zone");
      const fileName = $("file-name");
      const formError = $("form-error");
      const previewButton = $("preview-button");
      const dialog = $("output-preview");
      const frame = $("preview-frame");
      const status = $("preview-status");
      const loading = $("preview-loading");
      const download = $("download-preview");
      const trySample = $("try-sample");
      const samplePages = $("sample-pages");
      const doneButton = $("done-preview");
      const picker = $("card-picker");
      const pickList = $("pick-list");
      const pickCount = $("pick-count");
      const pickNotes = $("pick-notes");
      const pickRestore = $("pick-restore");
      const finalButton = $("final-preview");
      const editButton = $("edit-cards");
      const skipInput = $("skip-cards");
      let opener = previewButton;

      const MAX_BYTES = 30 * 1024 * 1024;
      let previewURL = null;
      let controller = null;
      let requestVersion = 0;
      // Key Facts: the cards the upload makes, in print order, and the numbers of those the parent took out.
      let cards = [];
      const removed = new Set();

      // Progressive enhancement: the normal POST form also works without JS.
      if (typeof dialog.showModal === "function") {
        previewButton.hidden = false;
      }

      function showError(message = "") {
        formError.textContent = message;
        formError.hidden = !message;
      }

      function validateFile() {
        const file = fileInput.files[0];
        let message = "";

        if (file && !/\.pdf$/i.test(file.name)) {
          message = "Please choose a PDF file.";
        } else if (file && file.size > MAX_BYTES) {
          message = "This file is over 30 MB. Try a smaller PDF.";
        } else if (file && file.size === 0) {
          message = "This PDF looks empty. Please choose another file.";
        }

        fileInput.setCustomValidity(message);
        return message;
      }

      function validatePages() {
        const value = pagesInput.value.trim();
        let message = "";

        if (value) {
          const validSyntax =
            /^[1-9]\d*(?:\s*-\s*[1-9]\d*)?(?:\s*,\s*[1-9]\d*(?:\s*-\s*[1-9]\d*)?)*$/.test(value);

          if (!validSyntax) {
            message = "Use page numbers like 3-5 or 2, 4.";
          } else {
            const validRanges = value.split(",").every((part) => {
              const [start, end = start] = part.trim().split("-").map(Number);
              return Number.isSafeInteger(start) &&
                Number.isSafeInteger(end) && end >= start;
            });

            if (!validRanges) {
              message = "Check your page range. Try 3-5 rather than 5-3.";
            }
          }
        }

        pagesInput.setCustomValidity(message);
        return message;
      }

      function validateForm() {
        const message = validateFile() || validatePages();
        showError(message);
        return form.reportValidity();
      }

      function clearPreview() {
        frame.src = "about:blank";
        download.hidden = true;
        download.removeAttribute("href");

        if (previewURL) URL.revokeObjectURL(previewURL);
        previewURL = null;
      }

      function cancelRequest() {
        requestVersion++;
        if (controller) controller.abort();
        controller = null;
        previewButton.disabled = false;
        loading.hidden = true;
        frame.removeAttribute("aria-busy");
      }

      function clearCards() {
        cards = [];
        removed.clear();
        skipInput.value = "";
        pickList.replaceChildren();
        pickNotes.replaceChildren();
        pickNotes.hidden = true;
      }

      function invalidatePreview() {
        cancelRequest();
        clearPreview();
        clearCards();
      }

      function updateFile() {
        const file = fileInput.files[0];
        const message = validateFile();
        fileName.textContent = file ? file.name : "Choose a PDF or drop it here";
        upload.classList.toggle("has-file", Boolean(file) && !message);
        showError(message);
      }

      fileInput.addEventListener("change", updateFile);

      form.addEventListener("input", () => {
        invalidatePreview();
        validatePages();
        showError("");
      });

      form.addEventListener("change", invalidatePreview);

      // Key Facts cards can be looked through, and taken out, before the PDF is made.
      function updateMode() {
        const mode = form.elements.output?.value;
        previewButton.textContent = mode === "facts" ? "Preview and take out cards" : "Preview before printing";
      }

      form.addEventListener("change", updateMode);
      updateMode();

      form.addEventListener("submit", (event) => {
        if (!validateForm()) event.preventDefault();
      });

      // Custom validity must clear before the browser's next submission check.
      pagesInput.addEventListener("input", validatePages);

      ["dragenter", "dragover"].forEach((name) => {
        upload.addEventListener(name, (event) => {
          event.preventDefault();
          upload.classList.add("dragging");
        });
      });

      ["dragleave", "drop"].forEach((name) => {
        upload.addEventListener(name, () => upload.classList.remove("dragging"));
      });

      upload.addEventListener("drop", (event) => {
        event.preventDefault();
        const files = event.dataTransfer?.files;

        if (!files?.length) return;

        if (files.length !== 1) {
          showError("Choose one PDF at a time.");
          return;
        }

        try {
          fileInput.files = files;
          invalidatePreview();
          updateFile();
        } catch {
          showError("Please use the file picker to choose your PDF.");
        }
      });

      function closeDialog() {
        if (dialog.open) dialog.close();
      }

      $("close-preview").addEventListener("click", closeDialog);
      doneButton.addEventListener("click", closeDialog);

      dialog.addEventListener("close", () => {
        cancelRequest();
        document.body.classList.remove("modal-open");
        opener.focus();
      });

      // Native dialog supplies modal focus handling and Escape-to-close.
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;

        const rect = dialog.getBoundingClientRect();
        const outside =
          event.clientX < rect.left || event.clientX > rect.right ||
          event.clientY < rect.top || event.clientY > rect.bottom;

        if (outside) closeDialog();
      });

      // The dialog shows a PDF made from the upload, the Key Facts cards to look through, or the sample's pages.
      function showStage(stage) {
        frame.hidden = stage !== "pdf";
        picker.hidden = stage !== "pick";
        if (samplePages) samplePages.hidden = stage !== "sample";
        finalButton.hidden = stage !== "pick";
        editButton.hidden = !(stage === "pdf" && cards.length);
        // Key Facts has its own way on (see the PDF) and back (to the cards); the header's × still closes.
        doneButton.hidden = stage === "pick" || !editButton.hidden;
        doneButton.textContent = stage === "sample" ? "Close" : "Back to my cards";
        $("preview-title").textContent = {
          sample: "A sample case paper", pick: "Your Key Facts cards"
        }[stage] || "Your print preview";
      }

      if (trySample && samplePages && typeof dialog.showModal === "function") {
        trySample.addEventListener("click", (event) => {
          event.preventDefault();
          invalidatePreview();
          opener = trySample;
          showStage("sample");
          download.href = trySample.href;
          download.download = "learn_sample_case_papers.pdf";
          download.hidden = false;
          status.textContent =
            "This sample was made from our example sheet, “How green plants make food”. " +
            "Add your own PDF to make cards from your notes.";
          document.body.classList.add("modal-open");
          dialog.showModal();
        });
      }

      function element(tag, className, text = "") {
        const node = document.createElement(tag);
        if (className) node.className = className;
        node.textContent = text;  // the sheet's words go in as text, never as HTML
        return node;
      }

      function cardItem(card) {
        const item = element("li", "pick-card");
        const meta = element("p", "pick-meta");
        meta.append(element("span", "pick-number", `Card ${card.number}`));
        if (card.about) meta.append(element("span", "", card.about));
        meta.append(element("span", "", `p. ${card.page}`));
        const answer = element("p", "pick-answer", "Answer: ");
        answer.append(element("strong", "", card.answer || "Not on the sheet"));
        const remove = element("button", "pick-remove", "×");
        remove.type = "button";
        remove.setAttribute("aria-label", `Take out card ${card.number}`);
        remove.addEventListener("click", () => takeOut(card.number, item));
        item.append(meta, element("p", "pick-clue", card.clue), element("p", "pick-question", card.question), answer,
          remove);
        return item;
      }

      function renderCards() {
        pickList.replaceChildren(...cards.filter((card) => !removed.has(card.number)).map(cardItem));
        updateCount();
      }

      function updateCount() {
        const kept = cards.length - removed.size;
        pickCount.textContent = `${kept} of ${cards.length} cards kept`;
        pickRestore.hidden = !removed.size;
        finalButton.disabled = !kept;
        skipInput.value = [...removed].sort((a, b) => a - b).join(",");
        status.textContent = kept
          ? "Take out any card you don't want with ×, then see the final PDF."
          : "Every card is taken out. Put them back to print.";
      }

      function takeOut(number, item) {
        // Keep the keyboard on the cards: the next card's ×, or the count once none is left.
        const next = item.nextElementSibling || item.previousElementSibling;
        removed.add(number);
        item.remove();
        updateCount();
        (next?.querySelector(".pick-remove") || pickCount).focus();
      }

      pickRestore.addEventListener("click", () => {
        removed.clear();
        renderCards();
        pickCount.focus();
      });

      async function loadCards(data) {
        showStage("pick");
        const version = requestVersion;
        const activeController = new AbortController();
        controller = activeController;
        previewButton.disabled = true;
        finalButton.disabled = true;
        loading.hidden = false;
        status.textContent = "Finding the key facts in your sheet.";

        try {
          const response = await fetch("/key-facts", {
            method: "POST",
            body: data,
            signal: activeController.signal
          });
          const contentType = response.headers.get("content-type") || "";
          const body = contentType.includes("application/json") ? await response.json() : {};

          if (version !== requestVersion) return;
          if (!response.ok || !Array.isArray(body.cards)) {
            throw new Error(response.status === 413
              ? "The server could not accept this file size. Try a smaller PDF."
              : typeof body.error === "string" && body.error
              ? body.error
              : "We couldn't make your cards. Check your file and page range, then try again.");
          }

          cards = body.cards;
          const notes = Array.isArray(body.notes) ? body.notes : [];
          pickNotes.replaceChildren(...notes.map((note) => element("li", "", note)));
          pickNotes.hidden = !notes.length;
          renderCards();
        } catch (error) {
          if (version !== requestVersion) return;

          clearCards();
          finalButton.hidden = true;

          if (error.name !== "AbortError") {
            status.textContent = error instanceof TypeError
              ? "We couldn't connect. Check your connection and try again."
              : error.message;
          }
        } finally {
          if (version === requestVersion) {
            previewButton.disabled = false;
            loading.hidden = true;
            controller = null;
          }
        }
      }

      async function loadPDF(data, mode) {
        cancelRequest();
        clearPreview();
        showStage("pdf");

        const version = requestVersion;
        const activeController = new AbortController();
        controller = activeController;

        const modeLabel = { detective: "Detective", superhero: "Superhero", facts: "Key Facts" }[mode] || "study";
        let timedOut = false;

        previewButton.disabled = true;
        loading.hidden = false;
        frame.setAttribute("aria-busy", "true");
        status.textContent = mode === "detective"
          ? `Building your ${modeLabel} cards. Story cards can take a minute or two.`
          : `Building your ${modeLabel} cards.`;

        const timeout = setTimeout(() => {
          timedOut = true;
          activeController.abort();
        }, 180000);  // story cards for 5 pages, written and reviewed, can take up to about 2 minutes

        try {
          const response = await fetch("/preview", {
            method: "POST",
            body: data,
            signal: activeController.signal
          });

          const contentType = response.headers.get("content-type") || "";

          if (!response.ok || !contentType.toLowerCase().includes("application/pdf")) {
            // Avoid exposing raw server errors or reflecting HTML into the page.
            const message = response.status === 413
              ? "The server could not accept this file size. Try a smaller PDF."
              : response.status === 429
              ? "There are a lot of requests right now. Please try again shortly."
              : response.headers.get("x-learn-error")
              || "We couldn't create a PDF preview. Check your file and page range, then try again.";

            throw new Error(message);
          }

          const blob = await response.blob();

          if (version !== requestVersion) return;
          if (!blob.size) throw new Error("The preview was empty. Please try another PDF.");

          previewURL = URL.createObjectURL(blob);
          frame.src = previewURL;
          download.href = previewURL;
          download.download = { study: "learn_study_cards.pdf", facts: "learn_key_facts.pdf" }[mode]
            || `learn_${mode}_game.pdf`;
          download.hidden = false;
          status.textContent = mode === "facts"
            ? "This is the PDF you'll print. Go back to the cards to change it, or download it. " +
              "If the preview doesn't display in your browser, download the PDF."
            : "Your cards are ready. Check the questions and answers before printing. " +
              "If the preview doesn't display in your browser, download the PDF.";
        } catch (error) {
          if (version !== requestVersion) return;

          clearPreview();

          if (timedOut) {
            status.textContent =
              "The preview took too long. Try fewer pages or a smaller PDF.";
          } else if (error.name !== "AbortError") {
            status.textContent = error instanceof TypeError
              ? "We couldn't connect. Check your connection and try again."
              : error.message;
          }
        } finally {
          clearTimeout(timeout);

          if (version === requestVersion) {
            previewButton.disabled = false;
            loading.hidden = true;
            frame.removeAttribute("aria-busy");
            controller = null;
          }
        }
      }

      finalButton.addEventListener("click", () => {
        const data = new FormData(form);
        data.set("output", "facts");
        loadPDF(data, "facts");
      });

      editButton.addEventListener("click", () => {
        cancelRequest();
        clearPreview();
        showStage("pick");
        updateCount();
        pickCount.focus();
      });

      previewButton.addEventListener("click", () => {
        if (!validateForm()) return;

        const data = new FormData(form);
        const mode = String(data.get("output") || "detective");
        opener = previewButton;
        document.body.classList.add("modal-open");

        if (mode === "facts" && cards.length) {
          // The same upload and pages: the cards and any taken out are as the parent left them.
          showStage("pick");
          renderCards();
          dialog.showModal();
          return;
        }

        invalidatePreview();
        showStage(mode === "facts" ? "pick" : "pdf");
        dialog.showModal();
        if (mode === "facts") loadCards(data);
        else loadPDF(data, mode);
      });

      // Small, frame-scheduled pointer response; no motion on touch/reduced-motion.
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
      const scene = document.querySelector(".study-scene");
      const stack = document.querySelector(".scene-stack");
      let animationFrame = 0;

      scene.addEventListener("pointermove", (event) => {
        if (motion.matches || !finePointer.matches) return;

        const rect = scene.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;

        cancelAnimationFrame(animationFrame);
        animationFrame = requestAnimationFrame(() => {
          stack.style.setProperty("--rx", `${-y * 8}deg`);
          stack.style.setProperty("--ry", `${x * 10}deg`);
        });
      });

      scene.addEventListener("pointerleave", () => {
        cancelAnimationFrame(animationFrame);
        stack.style.setProperty("--rx", "0deg");
        stack.style.setProperty("--ry", "0deg");
      });
    })();
  </script>
</body>
</html>
