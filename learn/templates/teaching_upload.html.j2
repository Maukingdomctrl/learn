  <style>
    /* ---------- Design tokens ---------- */
    :root {
      color-scheme: light;
      --paper: #f7f8f2;
      --white: #fff;
      --ink: #18352c;
      --muted: #52655b;
      --forest: #173d32;
      --forest-light: #285a47;
      --lime: #ddf58b;
      --lilac: #e5def9;
      --peach: #ffe0cc;
      --line: #dce3d8;
      --radius: 28px;
      --shadow: 0 24px 70px -36px rgb(24 53 44 / 35%);
      --ease: cubic-bezier(.22, 1, .36, 1);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; }
    [hidden] { display: none !important; }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 24px;
    }

    body {
      margin: 0;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    body.modal-open { overflow: hidden; }
    button, input, select { font: inherit; }
    button, a, input, select { -webkit-tap-highlight-color: transparent; }
    button, select { cursor: pointer; }
    a { color: inherit; text-underline-offset: 4px; }
    button { color: inherit; }
    svg { display: block; }
    ::selection { color: var(--forest); background: var(--lime); }

    :focus-visible {
      outline: 3px solid #7052b5;
      outline-offset: 5px;
    }

    .container {
      width: min(1180px, calc(100% - 64px));
      margin-inline: auto;
    }

    .skip-link {
      position: fixed;
      inset: 12px auto auto 12px;
      z-index: 100;
      padding: 12px 20px;
      border-radius: 12px;
      background: var(--forest);
      color: white;
      transform: translateY(-160%);
    }

    .skip-link:focus { transform: none; }

    /* ---------- Quiet atmosphere ---------- */
    .ambient {
      position: absolute;
      inset: 0 0 auto;
      height: 1000px;
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
      background:
        radial-gradient(ellipse at 90% 12%, #e5ebd6 0, transparent 45%),
        radial-gradient(ellipse at 0% 35%, #eef0df 0, transparent 45%);
    }

    .ambient::after {
      content: "";
      position: absolute;
      inset: 0;
      opacity: .35;
      background-image: radial-gradient(#9eafa0 .8px, transparent .8px);
      background-size: 24px 24px;
      mask-image: linear-gradient(#000, transparent 85%);
    }

    /* ---------- Navigation ---------- */
    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding-block: 26px;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .brand-mark {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      color: var(--lime);
      background: var(--forest);
      font-size: 28px;
      font-weight: 900;
      box-shadow: 0 6px 0 #dce6d7;
      transition: transform .3s var(--ease);
    }

    .brand:hover .brand-mark { transform: rotate(-8deg); }
    .brand-name { font-size: 23px; font-weight: 850; letter-spacing: -.8px; }
    .brand-caption { display: block; font-size: 11px; color: var(--muted); }

    nav { display: flex; align-items: center; gap: 24px; }
    nav a { font-size: 13px; font-weight: 700; text-decoration: none; }
    nav a:hover { text-decoration: underline; }

    .free-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 13px;
      border: 1px solid #d3dec9;
      border-radius: 100px;
      background: #eef3e7;
      font-size: 12px;
      font-weight: 750;
      white-space: nowrap;
    }

    .free-pill::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #35673a;
    }

    /* ---------- Hero ---------- */
    .hero {
      display: grid;
      grid-template-columns: 1.08fr .92fr;
      align-items: center;
      gap: 72px;
      padding-block: 76px 68px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin: 0 0 22px;
      color: var(--forest-light);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .eyebrow span {
      padding: 4px 8px;
      border-radius: 6px;
      background: var(--lime);
      letter-spacing: .03em;
    }

    h1, h2, h3, p { margin-top: 0; }

    h1 {
      max-width: 12ch;
      margin-bottom: 24px;
      font-size: clamp(44px, 5.5vw, 72px);
      font-weight: 850;
      line-height: 1.04;
      letter-spacing: -.065em;
      text-wrap: balance;
    }

    .highlight {
      position: relative;
      isolation: isolate;
      white-space: nowrap;
    }

    .highlight::before {
      content: "";
      position: absolute;
      inset: 55% -5px 2px;
      z-index: -1;
      border-radius: 5px;
      background: var(--lime);
      transform: rotate(-2deg);
    }

    .intro {
      max-width: 43ch;
      margin-bottom: 24px;
      font-size: 17px;
      color: var(--muted);
      line-height: 1.8;
    }

    .benefits {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      padding: 0;
      margin: 0;
      list-style: none;
      color: var(--forest);
      font-size: 12px;
      font-weight: 700;
    }

    .benefits li::before { content: "✓"; margin-right: 7px; }

    /* ---------- Animated study-card composition ---------- */
    .study-scene {
      position: relative;
      height: 260px;
      max-width: 470px;
      margin-top: 35px;
      perspective: 1000px;
    }

    .scene-orbit {
      position: absolute;
      width: 235px;
      height: 235px;
      top: 8px;
      left: 80px;
      border: 1px dashed #bdcbb8;
      border-radius: 50%;
    }

    .scene-orbit::after {
      content: "";
      position: absolute;
      top: 30px;
      right: 22px;
      width: 13px;
      height: 13px;
      border: 4px solid var(--paper);
      border-radius: 50%;
      background: var(--forest);
      box-shadow: 0 0 0 1px #bdcbb8;
    }

    .scene-stack {
      position: relative;
      height: 100%;
      transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
      transition: transform .6s var(--ease);
    }

    .sample {
      position: absolute;
      width: 218px;
      min-height: 154px;
      padding: 20px;
      border: 1px solid rgb(24 53 44 / 12%);
      border-radius: 19px;
      box-shadow: 0 16px 32px -20px rgb(24 53 44 / 50%);
    }

    .sample-back {
      left: 155px;
      top: 19px;
      background: var(--lilac);
      rotate: 11deg;
      animation: bob 7s ease-in-out infinite;
    }

    .sample-front {
      left: 35px;
      top: 77px;
      color: white;
      background: var(--forest);
      rotate: -8deg;
      animation: bob 7s ease-in-out -3s infinite;
    }

    .sample-top {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 16px;
      font-size: 9px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .sample-front .sample-top { color: var(--lime); }
    .sample p { margin: 0; font-size: 15px; font-weight: 700; line-height: 1.5; }

    .sample-foot {
      display: block;
      margin-top: 17px;
      padding-top: 9px;
      border-top: 1px solid rgb(255 255 255 / 20%);
      font-size: 10px;
      color: #e0e9df;
    }

    .scene-sticker {
      position: absolute;
      right: 4px;
      bottom: 12px;
      display: grid;
      place-items: center;
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: var(--peach);
      border: 5px solid var(--paper);
      font-size: 11px;
      font-weight: 850;
      text-align: center;
      line-height: 1.3;
      rotate: 12deg;
    }

    /* ---------- Builder ---------- */
    .builder {
      position: relative;
      padding: 30px;
      border: 1px solid white;
      border-radius: 32px;
      background: rgb(255 255 255 / 94%);
      box-shadow: var(--shadow), 0 0 0 1px rgb(24 53 44 / 5%);
    }

    .builder::before {
      content: "";
      position: absolute;
      inset: 12px -9px -12px 12px;
      z-index: -1;
      border-radius: 32px;
      border: 1px solid #dce3d3;
      background: #e9efdf;
      rotate: 2deg;
    }

    .builder-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 24px;
    }

    .builder-heading h2 {
      margin: 0;
      font-size: 23px;
      letter-spacing: -.8px;
      line-height: 1.25;
    }

    .builder-heading p {
      margin: 5px 0 0;
      color: var(--muted);
      font-size: 12px;
    }

    .mini-icon {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      flex-shrink: 0;
      border-radius: 14px;
      background: var(--lime);
    }

    .field-label, legend {
      display: block;
      margin-bottom: 9px;
      font-size: 12px;
      font-weight: 800;
    }

    .optional { color: var(--muted); font-weight: 500; }
    .field { margin-top: 21px; }

    .upload {
      position: relative;
      display: grid;
      justify-items: center;
      gap: 5px;
      padding: 24px 16px;
      border: 1.5px dashed #b7c6ac;
      border-radius: 18px;
      background: #f7f9f2;
      text-align: center;
      transition: background .2s, border-color .2s, transform .3s var(--ease);
    }

    .upload:hover, .upload.dragging {
      background: #eff5e3;
      border-color: var(--forest);
      transform: translateY(-2px);
    }

    .upload:focus-within { outline: 3px solid #7052b5; outline-offset: 4px; }

    .upload input {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
    }

    .upload-icon {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      margin-bottom: 5px;
      border-radius: 13px;
      background: white;
      border: 1px solid var(--line);
    }

    .upload strong {
      max-width: 100%;
      overflow-wrap: anywhere;
      font-size: 13px;
    }

    .upload small { color: var(--muted); font-size: 11px; }

    input[type="text"] {
      width: 100%;
      min-height: 47px;
      padding: 11px 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #fbfcf9;
      color: var(--ink);
      font-size: 13px;
      transition: border-color .2s, box-shadow .2s;
    }

    input[type="text"]:focus {
      border-color: var(--forest);
      box-shadow: 0 0 0 4px #edf3e5;
    }

    .hint {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 11px;
      line-height: 1.6;
    }

    fieldset { min-width: 0; padding: 0; border: 0; margin: 21px 0 0; }
    legend { padding: 0; }
    .game-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

    .game-option { position: relative; cursor: pointer; }

    .game-option input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    .game-tile {
      display: flex;
      align-items: center;
      gap: 9px;
      height: 100%;
      padding: 13px 10px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: white;
      transition: background .2s, border-color .2s, transform .2s;
    }

    .game-tile strong { display: block; font-size: 12px; }
    .game-tile small { display: block; color: var(--muted); font-size: 10px; }
    .game-symbol { font-size: 20px; }

    .game-option input:checked + .game-tile {
      background: #f0f6e6;
      border-color: var(--forest);
      box-shadow: inset 0 0 0 1px var(--forest);
    }

    .game-option input:focus-visible + .game-tile {
      outline: 3px solid #7052b5;
      outline-offset: 3px;
    }

    .game-option:hover .game-tile { transform: translateY(-2px); }
    .actions { display: grid; gap: 9px; margin-top: 24px; }

    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 48px;
      padding: 12px 18px;
      border: 1px solid transparent;
      border-radius: 13px;
      background: var(--forest);
      color: white;
      font-size: 13px;
      font-weight: 750;
      text-decoration: none;
      transition: transform .25s var(--ease), background .2s, box-shadow .25s;
    }

    .button:hover {
      background: var(--forest-light);
      transform: translateY(-2px);
      box-shadow: 0 9px 20px -12px var(--forest);
    }

    .button:active { transform: translateY(0); }
    .button:disabled { opacity: .6; cursor: wait; transform: none; }
    .button svg { width: 17px; height: 17px; }

    .button-secondary {
      background: white;
      border-color: var(--line);
      color: var(--ink);
    }

    .button-secondary:hover { background: #f6f8f1; }

    .form-note {
      margin: 14px 0 0;
      color: var(--muted);
      text-align: center;
      font-size: 10px;
    }

    .form-error { margin: 12px 0 0; color: #a32c26; font-size: 12px; }

    /* ---------- Helpful, crawlable content ---------- */
    .how-section {
      padding-block: 48px 64px;
      border-top: 1px solid var(--line);
    }

    .section-top {
      display: flex;
      justify-content: space-between;
      align-items: end;
      gap: 24px;
      margin-bottom: 26px;
    }

    .section-kicker {
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 10px;
      font-weight: 850;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    h2 { margin-bottom: 0; font-size: clamp(25px, 3vw, 34px); letter-spacing: -1.2px; line-height: 1.2; }
    .text-link { font-size: 12px; font-weight: 750; }

    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

    .step {
      padding: 25px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: rgb(255 255 255 / 55%);
      transition: transform .3s var(--ease), box-shadow .3s;
    }

    .step:hover { transform: translateY(-5px); box-shadow: var(--shadow); }

    .step-number {
      display: grid;
      place-items: center;
      width: 34px;
      height: 34px;
      margin-bottom: 20px;
      border-radius: 10px;
      background: var(--lime);
      font-size: 11px;
      font-weight: 850;
    }

    .step:nth-child(2) .step-number { background: var(--lilac); }
    .step:nth-child(3) .step-number { background: var(--peach); }
    .step h3 { margin-bottom: 8px; font-size: 15px; letter-spacing: -.3px; }
    .step p { margin: 0; color: var(--muted); font-size: 13px; }

    .faq {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 70px;
      padding-block: 12px 70px;
    }

    .faq-intro p:last-child { margin-top: 16px; color: var(--muted); font-size: 14px; }

    details { border-bottom: 1px solid var(--line); }
    summary {
      padding: 18px 32px 18px 0;
      position: relative;
      list-style: none;
      font-size: 14px;
      font-weight: 750;
      cursor: pointer;
    }

    summary::-webkit-details-marker { display: none; }
    summary::after { content: "+"; position: absolute; right: 4px; font-size: 20px; top: 12px; }
    details[open] summary::after { content: "−"; }
    details p { padding-right: 26px; color: var(--muted); font-size: 13px; }

    .site-footer {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding-block: 23px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 11px;
    }

    /* ---------- Native modal preview ---------- */
    .preview {
      position: fixed;
      inset: 0 0 0 auto;
      width: min(700px, 100%);
      max-width: 100%;
      height: 100%;
      height: 100dvh;
      max-height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      color: var(--ink);
      background: var(--paper);
      box-shadow: -25px 0 90px rgb(0 0 0 / 15%);
    }

    .preview[open] {
      display: flex;
      flex-direction: column;
      animation: drawer-in .35s var(--ease);
    }

    .preview::backdrop { background: rgb(14 31 25 / 50%); }

    .preview-head, .preview-foot {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 20px 24px;
      flex-shrink: 0;
    }

    .preview-head { border-bottom: 1px solid var(--line); }
    .preview-head h2 { font-size: 23px; }
    .preview-foot { border-top: 1px solid var(--line); flex-wrap: wrap; }

    .icon-button {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: white;
      font-size: 24px;
    }

    .preview-body {
      display: flex;
      flex-direction: column;
      flex: 1;
      min-height: 0;
      padding: 20px 24px;
      gap: 16px;
      overflow: auto;
    }

    .preview-status { margin: 0; color: var(--muted); font-size: 13px; }

    .preview-frame {
      width: 100%;
      flex: 1;
      min-height: 240px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: white;
    }

    .preview-loading {
      height: 3px;
      overflow: hidden;
      border-radius: 3px;
      background: #dce5d3;
      flex-shrink: 0;
    }

    .preview-loading::after {
      content: "";
      display: block;
      width: 35%;
      height: 100%;
      background: var(--forest);
      animation: loading 1.2s ease-in-out infinite;
    }

    /* ---------- Motion ---------- */
    @keyframes bob { 50% { translate: 0 -9px; } }
    @keyframes drawer-in { from { transform: translateX(100%); } to { transform: none; } }
    @keyframes loading { from { transform: translateX(-110%); } to { transform: translateX(390%); } }
    @keyframes arrive {
      from { opacity: 0; transform: translateY(18px); }
      to { opacity: 1; transform: none; }
    }

    .hero-copy { animation: arrive .8s var(--ease) both; }
    .builder { animation: arrive .8s .12s var(--ease) both; }

    /* ---------- Responsive ---------- */
    @media (min-width: 900px) {
      .how-section, .faq { content-visibility: auto; contain-intrinsic-size: auto 380px; }
    }

    @media (max-width: 1000px) {
      .hero { gap: 36px; }
      .builder { padding: 24px; }
      .sample-back { left: 115px; }
      .scene-sticker { right: 0; }
    }

    @media (max-width: 800px) {
      .container { width: min(600px, calc(100% - 40px)); }
      .hero { grid-template-columns: 1fr; gap: 32px; padding-block: 44px; }
      h1 { max-width: 15ch; font-size: clamp(43px, 8vw, 62px); }
      .intro { max-width: 48ch; }
      .study-scene { display: none; }
      nav a { display: none; }
      .steps { grid-template-columns: 1fr; }
      .step { padding: 22px; }
      .step-number { margin-bottom: 14px; }
      .faq { grid-template-columns: 1fr; gap: 15px; }
      .section-top { align-items: start; flex-direction: column; gap: 14px; }
      .builder::before { inset: 10px -5px -8px 8px; rotate: 1deg; }
    }

    @media (max-width: 380px) {
      .container { width: calc(100% - 28px); }
      .builder { padding: 20px; }
      .free-pill { padding: 7px 9px; font-size: 10px; }
      .game-grid { grid-template-columns: 1fr; }
      .brand-caption { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation: none !important;
        transition: none !important;
      }
      .scene-stack { transform: none !important; }
    }
  </style>
</head>

<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="ambient" aria-hidden="true"></div>

  <header class="site-header container">
    <a class="brand" href="/" aria-label="Learn Teaching Engine home">
      <span class="brand-mark" aria-hidden="true">L</span>
      <span>
        <span class="brand-name">Learn</span>
        <span class="brand-caption">A little curiosity goes a long way.</span>
      </span>
    </a>

    <nav aria-label="Main navigation">
      <a href="#how-it-works">How it works</a>
      <a href="/library">Study library</a>
      <span class="free-pill">Free · No sign-up</span>
    </nav>
  </header>

  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span>Grade 8</span> Big ideas. Small cards.</p>

        <h1 id="hero-title">
          Turn your PDF into a <span class="highlight">study quest.</span>
        </h1>

        <p class="intro">
          Less staring at notes. More figuring things out.
          Turn your curriculum PDF into printable question cards,
          then solve a mystery{% if show_superhero %} or take on a superhero mission{% endif %}.
        </p>

        <ul class="benefits" aria-label="Features">
          <li>Print-ready cards</li>
          <li>Answer sheet included</li>
          <li>No account needed</li>
        </ul>

        <div class="study-scene" aria-hidden="true">
          <div class="scene-orbit"></div>
          <div class="scene-stack">
            <div class="sample sample-back">
              <div class="sample-top">
                <span>Biology</span><span>Sample · 02</span>
              </div>
              <p>How do plants turn sunlight into food?</p>
            </div>

            <div class="sample sample-front">
              <div class="sample-top">
                <span>Detective mode</span><span>Sample · 01</span>
              </div>
              <p>Your cell needs energy. Which organelle is on the case?</p>
              <span class="sample-foot">Think it through. Then check your answer.</span>
            </div>
          </div>
          <div class="scene-sticker">A fresh way<br>to revise ↗</div>
        </div>
      </div>

      <section class="builder" aria-labelledby="builder-title">
        <div class="builder-heading">
          <div>
            <h2 id="builder-title">Build your study cards</h2>
            <p>Your notes. A new way to know them.</p>
          </div>
          <span class="mini-icon" aria-hidden="true">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.6">
              <rect x="7" y="4" width="13" height="16" rx="3"/>
              <path d="M4 7H3v12a3 3 0 0 0 3 3h9M11 9h5m-5 4h5"/>
            </svg>
          </span>
        </div>

        <form id="teaching-form" action="/generate" method="post"
          enctype="multipart/form-data">
          <label class="field-label" for="pdf">1. Add your curriculum PDF</label>

          <div class="upload" id="upload-zone">
            <span class="upload-icon" aria-hidden="true">
              <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 16V4m-4 4 4-4 4 4M4 16v4h16v-4"/>
              </svg>
            </span>
            <strong id="file-name">Choose a PDF or drop it here</strong>
            <small id="file-help">Up to 30 MB · Text-based PDFs work best</small>
            <input id="pdf" type="file" name="pdf"
              accept=".pdf,application/pdf" required
              aria-describedby="file-help file-name">
          </div>

          <div class="field">
            <label class="field-label" for="pages">
              2. Pick your pages <span class="optional">(optional)</span>
            </label>
            <input id="pages" name="pages" type="text"
              maxlength="50" placeholder="For example: 3-5 or 2, 4"
              aria-describedby="pages-help" autocomplete="off"
              spellcheck="false">
            <p class="hint" id="pages-help">
              Use the PDF's page numbers. Leave blank to use all pages.
            </p>
          </div>

          <input type="hidden" name="standard" value="8">

          {% if show_games %}
          <fieldset>
            <legend>3. Choose your adventure</legend>
            <div class="game-grid">
              <label class="game-option">
                <input type="radio" name="output" value="detective" checked>
                <span class="game-tile">
                  <span class="game-symbol" aria-hidden="true">⌕</span>
                  <span>
                    <strong>Detective</strong>
                    <small>Follow the clues</small>
                  </span>
                </span>
              </label>

              {% if show_superhero %}
              <label class="game-option">
                <input type="radio" name="output" value="superhero">
                <span class="game-tile">
                  <span class="game-symbol" aria-hidden="true">ϟ</span>
                  <span>
                    <strong>Superhero</strong>
                    <small>Take on a mission</small>
                  </span>
                </span>
              </label>
              {% endif %}
            </div>
          </fieldset>
          {% else %}
          <input type="hidden" name="output" value="study">
          {% endif %}

          <p class="form-error" id="form-error" role="alert" hidden></p>

          <div class="actions">
            <button class="button" type="submit">
              Create my study cards
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                stroke-width="1.8" aria-hidden="true">
                <path d="M5 12h14m-6-6 6 6-6 6"/>
              </svg>
            </button>

            <button class="button button-secondary" id="preview-button"
              type="button" aria-haspopup="dialog"
              aria-controls="output-preview" hidden>
              Preview before printing
            </button>
          </div>

          <p class="form-note">
            No account or API key needed. Check your answers before class.
          </p>
        </form>

        <noscript>
          <p class="hint">
            You can still create cards. Enable JavaScript for an in-page preview.
          </p>
        </noscript>
      </section>
    </section>

    <section class="how-section container" id="how-it-works"
      aria-labelledby="how-title">
      <div class="section-top">
        <div>
          <p class="section-kicker">From notes to know-how</p>
          <h2 id="how-title">Three steps. A different kind of revision.</h2>
        </div>
        <a class="text-link" href="/library">Explore the study library ↗</a>
      </div>

      <div class="steps">
        <article class="step">
          <span class="step-number" aria-hidden="true">01</span>
          <h3>Start with what you're learning</h3>
          <p>
            Upload a curriculum PDF or study sheet. Choose one topic
            or a few pages to keep your session focused.
          </p>
        </article>

        <article class="step">
          <span class="step-number" aria-hidden="true">02</span>
          <h3>Make it a mission</h3>
          <p>
            Pick {% if show_superhero %}Detective or Superhero{% else %}Detective mode{% endif %}. Preview your question cards
            and check that the content matches your lesson.
          </p>
        </article>

        <article class="step">
          <span class="step-number" aria-hidden="true">03</span>
          <h3>Print. Think. Try again.</h3>
          <p>
            Cut out your cards. Answer on your own or quiz a friend,
            then use the answer sheet to see what needs another look.
          </p>
        </article>
      </div>
    </section>

    <section class="faq container" aria-labelledby="faq-title">
      <div class="faq-intro">
        <p class="section-kicker">Good questions welcome</p>
        <h2 id="faq-title">Before you start</h2>
        <p>
          A few useful things to know about making printable
          study cards from your PDF.
        </p>
      </div>

      <div>
        <details>
          <summary>What kind of PDF should I upload?</summary>
          <p>
            Use a text-based curriculum PDF, lesson handout, or study sheet
            up to 30 MB. PDFs with selectable text work best.
            Scanned pages or photos may not produce useful cards.
          </p>
        </details>

        <details>
          <summary>Is this designed for Grade 8?</summary>
          <p>
            This page uses the Grade 8 setting. Upload material from your
            own lessons so the cards match what you are studying.
            The quality and difficulty of the cards also depend on your PDF.
          </p>
        </details>

        <details>
          <summary>Do I need an account or an API key?</summary>
          <p>
            No. You can upload a PDF, preview the output, and create your
            printable cards without signing up or supplying an API key.
          </p>
        </details>

        <details>
          <summary>Should I check the cards before using them?</summary>
          <p>
            Yes. Compare questions and answers with your source material.
            Ask your teacher about anything unclear, and review any flagged
            claims before using the cards in class.
          </p>
        </details>

        <details>
          <summary>How do I print the cards?</summary>
          <p>
            Preview or download the generated PDF, then open it in your
            PDF viewer to print. Check its page layout and any printing
            instructions before choosing double-sided settings.
          </p>
        </details>
      </div>
    </section>
  </main>

  <footer class="site-footer container">
    <span>Learn Teaching Engine · Make room for curiosity.</span>
    <a href="/blank-cards" download>Blank study cards (PDF) ↓</a>
    <a href="/library">Study Visual Library ↗</a>
  </footer>

  <dialog class="preview" id="output-preview"
    aria-labelledby="preview-title" aria-describedby="preview-status">
    <div class="preview-head">
      <div>
        <p class="section-kicker">One last look</p>
        <h2 id="preview-title">Your print preview</h2>
      </div>
      <button class="icon-button" id="close-preview"
        type="button" aria-label="Close preview" autofocus>×</button>
    </div>

    <div class="preview-body">
      <p class="preview-status" id="preview-status"
        role="status" aria-live="polite"></p>
      <div class="preview-loading" id="preview-loading"
        aria-hidden="true" hidden></div>
      <iframe class="preview-frame" id="preview-frame"
        title="Generated study cards PDF preview" src="about:blank"></iframe>
    </div>

    <div class="preview-foot">
      <a class="button" id="download-preview" hidden>Download PDF ↗</a>
      <button class="button button-secondary" id="done-preview" type="button">
        Back to my cards
      </button>
    </div>
  </dialog>

  <script>
    (() => {
      "use strict";

      const $ = (id) => document.getElementById(id);
      const form = $("teaching-form");
      const fileInput = $("pdf");
      const pagesInput = $("pages");
      const upload = $("upload-zone");
      const fileName = $("file-name");
      const formError = $("form-error");
      const previewButton = $("preview-button");
      const dialog = $("output-preview");
      const frame = $("preview-frame");
      const status = $("preview-status");
      const loading = $("preview-loading");
      const download = $("download-preview");

      const MAX_BYTES = 30 * 1024 * 1024;
      let previewURL = null;
      let controller = null;
      let requestVersion = 0;

      // Progressive enhancement: the normal POST form also works without JS.
      if (typeof dialog.showModal === "function") {
        previewButton.hidden = false;
      }

      function showError(message = "") {
        formError.textContent = message;
        formError.hidden = !message;
      }

      function validateFile() {
        const file = fileInput.files[0];
        let message = "";

        if (file && !/\.pdf$/i.test(file.name)) {
          message = "Please choose a PDF file.";
        } else if (file && file.size > MAX_BYTES) {
          message = "This file is over 30 MB. Try a smaller PDF.";
        } else if (file && file.size === 0) {
          message = "This PDF looks empty. Please choose another file.";
        }

        fileInput.setCustomValidity(message);
        return message;
      }

      function validatePages() {
        const value = pagesInput.value.trim();
        let message = "";

        if (value) {
          const validSyntax =
            /^[1-9]\d*(?:\s*-\s*[1-9]\d*)?(?:\s*,\s*[1-9]\d*(?:\s*-\s*[1-9]\d*)?)*$/.test(value);

          if (!validSyntax) {
            message = "Use page numbers like 3-5 or 2, 4.";
          } else {
            const validRanges = value.split(",").every((part) => {
              const [start, end = start] = part.trim().split("-").map(Number);
              return Number.isSafeInteger(start) &&
                Number.isSafeInteger(end) && end >= start;
            });

            if (!validRanges) {
              message = "Check your page range. Try 3-5 rather than 5-3.";
            }
          }
        }

        pagesInput.setCustomValidity(message);
        return message;
      }

      function validateForm() {
        const message = validateFile() || validatePages();
        showError(message);
        return form.reportValidity();
      }

      function clearPreview() {
        frame.src = "about:blank";
        download.hidden = true;
        download.removeAttribute("href");

        if (previewURL) URL.revokeObjectURL(previewURL);
        previewURL = null;
      }

      function cancelRequest() {
        requestVersion++;
        if (controller) controller.abort();
        controller = null;
        previewButton.disabled = false;
        loading.hidden = true;
        frame.removeAttribute("aria-busy");
      }

      function invalidatePreview() {
        cancelRequest();
        clearPreview();
      }

      function updateFile() {
        const file = fileInput.files[0];
        fileName.textContent = file ? file.name : "Choose a PDF or drop it here";
        showError(validateFile());
      }

      fileInput.addEventListener("change", updateFile);

      form.addEventListener("input", () => {
        invalidatePreview();
        validatePages();
        showError("");
      });

      form.addEventListener("change", invalidatePreview);

      form.addEventListener("submit", (event) => {
        if (!validateForm()) event.preventDefault();
      });

      // Custom validity must clear before the browser's next submission check.
      pagesInput.addEventListener("input", validatePages);

      ["dragenter", "dragover"].forEach((name) => {
        upload.addEventListener(name, (event) => {
          event.preventDefault();
          upload.classList.add("dragging");
        });
      });

      ["dragleave", "drop"].forEach((name) => {
        upload.addEventListener(name, () => upload.classList.remove("dragging"));
      });

      upload.addEventListener("drop", (event) => {
        event.preventDefault();
        const files = event.dataTransfer?.files;

        if (!files?.length) return;

        if (files.length !== 1) {
          showError("Choose one PDF at a time.");
          return;
        }

        try {
          fileInput.files = files;
          invalidatePreview();
          updateFile();
        } catch {
          showError("Please use the file picker to choose your PDF.");
        }
      });

      function closeDialog() {
        if (dialog.open) dialog.close();
      }

      $("close-preview").addEventListener("click", closeDialog);
      $("done-preview").addEventListener("click", closeDialog);

      dialog.addEventListener("close", () => {
        cancelRequest();
        document.body.classList.remove("modal-open");
        previewButton.focus();
      });

      // Native dialog supplies modal focus handling and Escape-to-close.
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;

        const rect = dialog.getBoundingClientRect();
        const outside =
          event.clientX < rect.left || event.clientX > rect.right ||
          event.clientY < rect.top || event.clientY > rect.bottom;

        if (outside) closeDialog();
      });

      previewButton.addEventListener("click", async () => {
        if (!validateForm()) return;

        invalidatePreview();

        const version = requestVersion;
        const activeController = new AbortController();
        controller = activeController;

        const data = new FormData(form);
        const mode = String(data.get("output") || "detective");
        const modeLabel = { detective: "Detective", superhero: "Superhero" }[mode] || "study";
        let timedOut = false;

        previewButton.disabled = true;
        loading.hidden = false;
        frame.setAttribute("aria-busy", "true");
        status.textContent =
          `Building your ${modeLabel} cards. Larger PDFs may take a little longer.`;

        document.body.classList.add("modal-open");
        dialog.showModal();

        const timeout = setTimeout(() => {
          timedOut = true;
          activeController.abort();
        }, 120000);

        try {
          const response = await fetch("/preview", {
            method: "POST",
            body: data,
            signal: activeController.signal
          });

          const contentType = response.headers.get("content-type") || "";

          if (!response.ok || !contentType.toLowerCase().includes("application/pdf")) {
            // Avoid exposing raw server errors or reflecting HTML into the page.
            const message = response.status === 413
              ? "The server could not accept this file size. Try a smaller PDF."
              : response.status === 429
              ? "There are a lot of requests right now. Please try again shortly."
              : "We couldn't create a PDF preview. Check your file and page range, then try again.";

            throw new Error(message);
          }

          const blob = await response.blob();

          if (version !== requestVersion) return;
          if (!blob.size) throw new Error("The preview was empty. Please try another PDF.");

          previewURL = URL.createObjectURL(blob);
          frame.src = previewURL;
          download.href = previewURL;
          download.download = mode === "study" ? "learn_study_cards.pdf" : `learn_${mode}_game.pdf`;
          download.hidden = false;
          status.textContent =
            "Your cards are ready. Check the questions and answers before printing. " +
            "If the preview doesn't display in your browser, download the PDF.";
        } catch (error) {
          if (version !== requestVersion) return;

          clearPreview();

          if (timedOut) {
            status.textContent =
              "The preview took too long. Try fewer pages or a smaller PDF.";
          } else if (error.name !== "AbortError") {
            status.textContent = error instanceof TypeError
              ? "We couldn't connect. Check your connection and try again."
              : error.message;
          }
        } finally {
          clearTimeout(timeout);

          if (version === requestVersion) {
            previewButton.disabled = false;
            loading.hidden = true;
            frame.removeAttribute("aria-busy");
            controller = null;
          }
        }
      });

      // Small, frame-scheduled pointer response; no motion on touch/reduced-motion.
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
      const scene = document.querySelector(".study-scene");
      const stack = document.querySelector(".scene-stack");
      let animationFrame = 0;

      scene.addEventListener("pointermove", (event) => {
        if (motion.matches || !finePointer.matches) return;

        const rect = scene.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width - .5;
        const y = (event.clientY - rect.top) / rect.height - .5;

        cancelAnimationFrame(animationFrame);
        animationFrame = requestAnimationFrame(() => {
          stack.style.setProperty("--rx", `${-y * 8}deg`);
          stack.style.setProperty("--ry", `${x * 10}deg`);
        });
      });

      scene.addEventListener("pointerleave", () => {
        cancelAnimationFrame(animationFrame);
        stack.style.setProperty("--rx", "0deg");
        stack.style.setProperty("--ry", "0deg");
      });
    })();
  </script>
</body>
</html>
