<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if error %}We couldn’t make your study cards{% else %}Your teaching plan{% endif %} | Learn</title>
  <style>
    :root {
      color-scheme: light;
      --paper: #f7f8f2;
      --ink: #18352c;
      --muted: #52655b;
      --forest: #173d32;
      --forest-light: #285a47;
      --lime: #ddf58b;
      --line: #dce3d8;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    body { max-width: 640px; margin: 8vh auto; padding: 0 20px; color: var(--ink); background: var(--paper); font-size: 16px; line-height: 1.6; }
    :focus-visible { outline: 3px solid #7052b5; outline-offset: 4px; }
    main { padding: clamp(24px, 6vw, 44px); background: white; border: 1px solid var(--line); border-radius: 28px; box-shadow: 0 24px 70px -36px rgb(24 53 44 / 35%); }
    a { color: var(--forest-light); font-weight: 650; }
    .brand { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 28px; color: var(--ink); font-size: 18px; font-weight: 850; text-decoration: none; }
    .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 11px; background: var(--forest); color: var(--lime); font-size: 20px; font-weight: 900; }
    h1 { margin: 0 0 14px; font-size: clamp(26px, 5vw, 32px); letter-spacing: -.03em; line-height: 1.2; }
    .error { margin: 0 0 24px; padding: 12px 14px; border-radius: 12px; background: #fbeeea; color: #8b331c; }
    .button { display: inline-flex; align-items: center; min-height: 48px; padding: 12px 20px; border-radius: 13px; background: var(--forest); color: white; font-size: 15px; font-weight: 750; text-decoration: none; }
    .button:hover { background: var(--forest-light); }
  </style>
</head>
<body>
<main>
  <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">L</span>Learn</a>
  {% if error %}
    <h1>We couldn’t make your study cards</h1>
    <p class="error">{{ error }}</p>
    <p><a class="button" id="try-again" href="/">Try again</a></p>
    <script>
      // Going back keeps the chosen PDF and page range in the form when the browser still has that page.
      document.getElementById("try-again").addEventListener("click", (event) => {
        if (document.referrer.startsWith(location.origin + "/") && history.length > 1) {
          event.preventDefault();
          history.back();
        }
      });
    </script>
  {% else %}
    <h1>Your teaching plan is ready</h1>
    <p><a href="/jobs/{{ job }}/teaching_lesson.json" download>Download the source-linked teaching plan</a></p>
  {% endif %}
  {% if warnings %}
    <h2>Notes about the source</h2>
    <ul>{% for warning in warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
  {% endif %}
</main>
</body>
</html>
