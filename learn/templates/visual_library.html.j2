<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Study Visual Library | Learn</title>
  <style>
    :root {
      color-scheme: light;
      --paper: #f7f8f2;
      --ink: #18352c;
      --muted: #52655b;
      --forest: #173d32;
      --forest-light: #285a47;
      --lime: #ddf58b;
      --line: #dce3d8;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-size: 16px; line-height: 1.6; }
    a { color: var(--forest-light); text-underline-offset: 4px; }
    :focus-visible { outline: 3px solid #7052b5; outline-offset: 4px; }
    main { max-width: 1100px; margin: auto; padding: 22px 20px 56px; }
    .site-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; padding-bottom: 20px; margin-bottom: 32px; border-bottom: 1px solid var(--line); }
    .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-size: 20px; font-weight: 850; letter-spacing: -.6px; text-decoration: none; }
    .brand-mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 13px; background: var(--forest); color: var(--lime); font-size: 22px; font-weight: 900; }
    .back { padding-block: 10px; font-size: 14px; font-weight: 750; }
    h1 { margin: 0 0 12px; font-size: clamp(2rem, 6vw, 3rem); font-weight: 850; letter-spacing: -.04em; line-height: 1.1; }
    .intro { max-width: 720px; margin: 0; color: var(--muted); font-size: 17px; }
    .note { margin: 22px 0; padding: 14px 16px; border: 1px solid #ead7a8; border-radius: 14px; background: #fff8e6; font-size: 15px; }
    nav { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0; }
    nav a { padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; background: white; color: var(--ink); font-size: 14px; font-weight: 700; text-decoration: none; }
    nav a:hover { border-color: var(--forest); }
    nav a[aria-current="page"] { border-color: var(--forest); background: var(--forest); color: white; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
    article { overflow: hidden; background: white; border: 1px solid var(--line); border-radius: 18px; }
    article img { display: block; width: 100%; height: 210px; object-fit: contain; background: #eef1e8; }
    .copy { padding: 16px; }
    h2 { font-size: 1.1rem; line-height: 1.25; margin: 0 0 5px; }
    .topic, .region, .credits, .empty { color: var(--muted); }
    .region { font-size: 12px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
    .credits { margin-top: 12px; font-size: 14px; }
    .site-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 20px; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }
  </style>
</head>
<body>
<main>
  <header class="site-header">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">L</span>Learn</a>
    <a class="back" href="/">← Back to study cards</a>
  </header>
  <h1>Study Visual Library</h1>
  <p class="intro">A growing set of history, civics, and geography visuals for Standards 7–9, with Standard 8 as the starting focus. These are visual prompts—not textbook pages or replacements for source evidence.</p>
  <div class="note">Images load directly from Wikimedia Commons when you open this page. Learn does not copy or store them. Check the linked file page for the current license and attribution before reusing or printing an image. Topic tags are suggestions, not a claim that every school follows the same book or syllabus.</div>
  <nav aria-label="Filter image library">
    <a href="/library"{% if region == "all" %} aria-current="page"{% endif %}>All topics</a>
    <a href="/library?region=Indian%20Studies"{% if region == "Indian Studies" %} aria-current="page"{% endif %}>Indian Studies</a>
    <a href="/library?region=UK%20comparison"{% if region == "UK comparison" %} aria-current="page"{% endif %}>UK comparison</a>
  </nav>
  <section class="grid" aria-label="Visuals">
    {% for visual in visuals %}
    <article>
      <a href="{{ visual.source_url }}" target="_blank" rel="noopener noreferrer" aria-label="View source page for {{ visual.title }}">
        <img src="{{ visual.image_url }}" alt="{{ visual.title }}" loading="lazy" referrerpolicy="no-referrer">
      </a>
      <div class="copy">
        <div class="region">{{ visual.region }}</div>
        <h2>{{ visual.title }}</h2>
        <div class="topic">{{ visual.topic }}</div>
        <p>{{ visual.description }}</p>
        <div class="credits">Image: {{ visual.author }} · <a href="{{ visual.license_url }}" target="_blank" rel="noopener noreferrer">{{ visual.license_name }}</a><br><a href="{{ visual.source_url }}" target="_blank" rel="noopener noreferrer">Source and image details on Wikimedia Commons</a></div>
      </div>
    </article>
    {% else %}
    <p class="empty">No visuals for this topic yet.</p>
    {% endfor %}
  </section>
  <footer class="site-footer">
    <span>Learn is made by {{ contact.name }} in {{ contact.city }}. <a href="mailto:{{ contact.email }}">{{ contact.email }}</a></span>
    <a href="/privacy">Privacy and your PDF</a>
  </footer>
</main>
</body>
</html>
