  {
   "id": "I11",
   "kind": "point",
   "text": "Major city of the West Midlands, lying on the River Rea.",
   "page": 1,
   "section": "notes",
   "topic": "BIRMINGHAM – West Midlands, England",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
