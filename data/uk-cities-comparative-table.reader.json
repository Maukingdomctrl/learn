  {
   "id": "I18",
   "kind": "point",
   "text": "Capital and largest city of Northern Ireland; second largest city on the island of Ireland.",
   "page": 1,
   "section": "notes",
   "topic": "BELFAST – Capital of Northern Ireland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "largest city of Northern Ireland"
   ]
  },
  {
   "id": "I19",
   "kind": "point",
   "text": "Situated on the River Lagan; population about 286,000 (2011 census).",
   "page": 1,
   "section": "notes",
   "topic": "BELFAST – Capital of Northern Ireland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "River Lagan",
    "286,000"
   ]
  },
  {
   "id": "I20",
   "kind": "point",
   "text": "Historic industries: Irish linen, tobacco processing, rope-making and shipbuilding.",
   "page": 1,
   "section": "notes",
   "topic": "BELFAST – Capital of Northern Ireland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "shipbuilding"
   ]
  },
  {
   "id": "I21",
   "kind": "point",
   "text": "Harland and Wolff shipyard built the RMS Titanic – once the world’s biggest and most productive shipyard.",
   "page": 1,
   "section": "notes",
   "topic": "BELFAST – Capital of Northern Ireland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "Harland and Wolff",
    "RMS Titanic"
   ]
  },
  {
   "id": "I22",
   "kind": "point",
   "text": "Key role in the Industrial Revolution; global industrial centre until the latter half of the 20th century.",
   "page": 1,
   "section": "notes",
   "topic": "BELFAST – Capital of Northern Ireland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": []
  },
  {
   "id": "I23",
   "kind": "point",
   "text": "Sustained major aerospace and missiles industry since the mid-1930s.",
   "page": 1,
   "section": "notes",
   "topic": "BELFAST – Capital of Northern Ireland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "aerospace and missiles industry"
   ]
  },
  {
   "id": "I24",
   "kind": "point",
   "text": "Today: centre for industry, arts, higher education, business and law – the economic engine of Northern Ireland.",
   "page": 1,
   "section": "notes",
   "topic": "BELFAST – Capital of Northern Ireland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "economic engine of Northern Ireland"
   ]
  },
  {
   "id": "I25",
   "kind": "point",
   "text": "Home to the Titanic Belfast interactive museum.",
