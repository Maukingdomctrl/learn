  {
   "id": "I27",
   "kind": "point",
   "text": "Capital city of Scotland; Scotland’s second most populous city and the seventh most populous in the UK.",
   "page": 1,
   "section": "notes",
   "topic": "EDINBURGH – Capital of Scotland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "second most populous",
    "seventh most populous"
   ]
  },
  {
   "id": "I28",
   "kind": "point",
   "text": "Home to the Scottish Parliament and the seat of the monarchy in Scotland.",
   "page": 1,
   "section": "notes",
   "topic": "EDINBURGH – Capital of Scotland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "Scottish Parliament",
    "seat of the monarchy"
   ]
  },
  {
   "id": "I29",
   "kind": "point",
   "text": "Second largest financial centre in the UK after London.",
   "page": 1,
   "section": "notes",
   "topic": "EDINBURGH – Capital of Scotland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "Second largest financial centre"
   ]
  },
  {
   "id": "I30",
   "kind": "point",
   "text": "Centre of banking for over 300 years: Bank of Scotland founded in 1695 (HQ in Edinburgh).",
   "page": 1,
   "section": "notes",
   "topic": "EDINBURGH – Capital of Scotland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "Bank of Scotland",
    "1695"
   ]
  },
  {
   "id": "I31",
   "kind": "point",
   "text": "Royal Bank of Scotland (RBS) has its global headquarters in Edinburgh.",
   "page": 1,
   "section": "notes",
   "topic": "EDINBURGH – Capital of Scotland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "Royal Bank of Scotland (RBS)"
   ]
  },
  {
   "id": "I32",
   "kind": "point",
   "text": "Tourism is a major mainstay: supports 30,000 jobs worth £1.6 billion to the city economy.",
   "page": 1,
   "section": "notes",
   "topic": "EDINBURGH – Capital of Scotland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "30,000 jobs",
    "£1.6 billion"
   ]
  },
  {
   "id": "I33",
   "kind": "point",
   "text": "Famous for its stunning mix of architecture: medieval tenements, Old Town, cobbled wynds and Georgian-era buildings.",
   "page": 1,
   "section": "notes",
   "topic": "EDINBURGH – Capital of Scotland",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": []
  },
  {
   "id": "I34",
   "kind": "topic",
   "text": "CARDIFF – Capital of Wales",
