  {
   "id": "I35",
   "kind": "point",
   "text": "Capital and largest city in Wales; the eleventh-largest city in the United Kingdom.",
   "page": 1,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "eleventh-largest"
   ]
  },
  {
   "id": "I36",
   "kind": "point",
   "text": "Country’s chief commercial centre; base for national cultural & sporting institutions, Welsh national media.",
   "page": 1,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": []
  },
  {
   "id": "I37",
   "kind": "point",
   "text": "Seat of the National Assembly for Wales (Senedd).",
   "page": 1,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "National Assembly for Wales"
   ]
  },
  {
   "id": "I38",
   "kind": "point",
   "text": "Was a small town until the early 19th century; rose as a major port for coal transport.",
   "page": 1,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "coal transport"
   ]
  },
  {
   "id": "I39",
   "kind": "point",
   "text": "Became the world’s most important coal port (handled more than London and Liverpool).",
   "page": 1,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "coal port"
   ]
  },
  {
   "id": "I40",
   "kind": "point",
   "text": "Made a city in 1905; proclaimed capital of Wales in 1955.",
   "page": 1,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "1905",
    "capital of Wales in 1955"
   ]
  },
  {
   "id": "I41",
   "kind": "point",
   "text": "Main engine of growth in the Welsh economy; centre for white-collar professions.",
   "page": 1,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": []
  },
  {
   "id": "I42",
   "kind": "point",
   "text": "Relies principally on retail, finance, media and tourism sectors.",
   "page": 2,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "retail, finance, media and tourism"
   ]
  },
  {
   "id": "I43",
   "kind": "point",
   "text": "Home to the Wales Millennium Centre – a thriving creative capital with rich cultural heritage.",
   "page": 2,
   "section": "notes",
   "topic": "CARDIFF – Capital of Wales",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": [
    "Wales Millennium Centre"
   ]
  },
