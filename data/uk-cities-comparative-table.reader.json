   ]
  },
  {
   "id": "I6",
   "kind": "point",
   "text": "One of the world’s preeminent cities – hub of political, economic and cultural network.",
   "page": 1,
   "section": "notes",
   "topic": "LONDON – Capital of the United Kingdom & England",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": []
  },
  {
   "id": "I7",
   "kind": "point",
   "text": "Metropolitan area covers much of southeastern England.",
   "page": 1,
   "section": "notes",
   "topic": "LONDON – Capital of the United Kingdom & England",
   "context": "",
   "marker": "",
   "bullet": true,
   "bold": []
  },
  {
