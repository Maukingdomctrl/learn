{"sheet": "history-sheet.pdf", "items": [{"id": "I1", "kind": "title", "text": "THE GREAT UPRISING OF 1857", "page": 1, "section": "", "topic": "", "context": "", "marker": "", "bullet": false, "bold": ["THE GREAT UPRISING OF 1857"]}, {"id": "I2", "kind": "title", "text": "Class 8 History | Sample notes", "page": 1, "section": "", "topic": "", "context": "", "marker": "", "bullet": false, "bold": ["Class 8 History | Sample notes"]}, {"id": "I3", "kind": "topic", "text": "CAUSES OF THE UPRISING", "page": 1, "section": "", "topic": "", "context": "", "marker": "1.", "bullet": false, "bold": ["CAUSES OF THE UPRISING"]}, {"id": "I4", "kind": "point", "text": "Political: Lord Dalhousie's Doctrine of Lapse annexed states whose rulers died without a natural heir; Jhansi and Nagpur were annexed this way.", "page": 1, "section": "", "topic": "CAUSES OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": ["Doctrine of Lapse"]}, {"id": "I5", "kind": "point", "text": "Economic: heavy land revenue demands pushed many peasants into debt.", "page": 1, "section": "", "topic": "CAUSES OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": ["land revenue"]}, {"id": "I6", "kind": "point", "text": "Military: Indian sepoys were paid less than British soldiers and had little chance of promotion.", "page": 1, "section": "", "topic": "CAUSES OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": ["paid less"]}, {"id": "I7", "kind": "point", "text": "Immediate cause: the cartridges of the new Enfield rifle were rumoured to be greased with cow and pig fat.", "page": 1, "section": "", "topic": "CAUSES OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": ["Enfield rifle"]}, {"id": "I8", "kind": "topic", "text": "COURSE OF THE UPRISING", "page": 1, "section": "", "topic": "", "context": "", "marker": "2.", "bullet": false, "bold": ["COURSE OF THE UPRISING"]}, {"id": "I9", "kind": "point", "text": "On 29 March 1857, Mangal Pandey attacked his officers at Barrackpore.", "page": 1, "section": "", "topic": "COURSE OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": ["Mangal Pandey", "Barrackpore"]}, {"id": "I10", "kind": "point", "text": "On 10 May 1857, sepoys at Meerut rose in revolt and marched to Delhi.", "page": 1, "section": "", "topic": "COURSE OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": ["Meerut"]}, {"id": "I11", "kind": "point", "text": "The rebels proclaimed Bahadur Shah Zafar as their emperor.", "page": 1, "section": "", "topic": "COURSE OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": ["Bahadur Shah Zafar"]}, {"id": "I12", "kind": "point", "text": "The British recaptured Delhi in September 1857.", "page": 1, "section": "", "topic": "COURSE OF THE UPRISING", "context": "", "marker": "", "bullet": true, "bold": []}, {"id": "I13", "kind": "topic", "text": "LEADERS AND CENTRES", "page": 1, "section": "", "topic": "", "context": "", "marker": "3.", "bullet": false, "bold": ["LEADERS AND CENTRES"]}, {"id": "I14", "kind": "point", "text": "Rani Lakshmibai led the fight at Jhansi.", "page": 1, "section": "", "topic": "LEADERS AND CENTRES", "context": "", "marker": "", "bullet": true, "bold": ["Rani Lakshmibai", "Jhansi"]}, {"id": "I15", "kind": "point", "text": "Nana Saheb led the revolt at Kanpur.", "page": 1, "section": "", "topic": "LEADERS AND CENTRES", "context": "", "marker": "", "bullet": true, "bold": ["Nana Saheb", "Kanpur"]}, {"id": "I16", "kind": "point", "text": "Begum Hazrat Mahal led the revolt at Lucknow.", "page": 1, "section": "", "topic": "LEADERS AND CENTRES", "context": "", "marker": "", "bullet": true, "bold": ["Begum Hazrat Mahal", "Lucknow"]}, {"id": "I17", "kind": "point", "text": "Kunwar Singh led the revolt in Bihar.", "page": 1, "section": "", "topic": "LEADERS AND CENTRES", "context": "", "marker": "", "bullet": true, "bold": ["Kunwar Singh", "Bihar"]}, {"id": "I18", "kind": "heading", "text": "RESULTS OF THE UPRISING", "page": 2, "section": "", "topic": "", "context": "", "marker": "4.", "bullet": false, "bold": ["RESULTS OF THE UPRISING"]}, {"id": "I19", "kind": "point", "text": "The Government of India Act, 1858 ended the rule of the East India Company.", "page": 2, "section": "", "topic": "", "context": "RESULTS OF THE UPRISING", "marker": "", "bullet": true, "bold": ["Government of India Act, 1858"]}, {"id": "I20", "kind": "point", "text": "Power passed to the British Crown; the Governor-General became the Viceroy.", "page": 2, "section": "", "topic": "", "context": "RESULTS OF THE UPRISING", "marker": "", "bullet": true, "bold": ["British Crown", "Viceroy"]}, {"id": "I21", "kind": "point", "text": "Queen Victoria's Proclamation of 1858 promised to respect Indian rulers and religions.", "page": 2, "section": "", "topic": "", "context": "RESULTS OF THE UPRISING", "marker": "", "bullet": true, "bold": ["Queen Victoria's Proclamation"]}, {"id": "I22", "kind": "point", "text": "The army was reorganised because the British wanted to prevent another revolt.", "page": 2, "section": "", "topic": "", "context": "RESULTS OF THE UPRISING", "marker": "", "bullet": true, "bold": []}, {"id": "I23", "kind": "point", "text": "The uprising led to the end of the Mughal dynasty.", "page": 2, "section": "", "topic": "", "context": "RESULTS OF THE UPRISING", "marker": "", "bullet": true, "bold": []}, {"id": "I24", "kind": "tip", "text": "Lapse, land, low pay and the rifle lit the fire.", "page": 2, "section": "", "topic": "", "context": "", "marker": "MEMORY TIP", "bullet": false, "bold": []}]}